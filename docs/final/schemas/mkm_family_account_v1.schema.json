{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkm_family_account_v1",
  "title": "MKM Family central account (jema-ai.com IdP anchor)",
  "type": "object",
  "required": ["schema", "mkm_account_id", "email", "created_at_utc", "auth_providers"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "mkm_family_account_v1" },
    "mkm_account_id": {
      "type": "string",
      "pattern": "^mkm_acc_[a-zA-Z0-9_-]{8,64}$"
    },
    "email": { "type": "string", "format": "email" },
    "email_verified": { "type": "boolean" },
    "display_name": { "type": "string", "maxLength": 120 },
    "picture_url": { "type": "string", "maxLength": 512 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "updated_at_utc": { "type": "string", "format": "date-time" },
    "auth_providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider", "provider_subject"],
        "additionalProperties": false,
        "properties": {
          "provider": { "enum": ["google"] },
          "provider_subject": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
