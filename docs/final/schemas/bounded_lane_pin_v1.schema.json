{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/bounded_lane_pin_v1.schema.json",
  "title": "Bounded lane loop pin v1",
  "description": "Thin per-lane context pin for mechanical loop resume. Not a chat transcript. Does not enqueue todo_queue_v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lane",
    "next_action_one_line",
    "forbidden",
    "steps"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bounded_lane_pin_v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "lane": {
      "type": "string",
      "enum": ["ms", "oracle", "infra", "design", "ops"]
    },
    "next_action_one_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "fact_lock_pointer": {
      "type": "string",
      "description": "Optional path to resume pack or artifact (no paste of full MISSION_LOG)."
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "track_a_promote",
          "live_trade",
          "todo_queue_enqueue",
          "mission_log_bulk_write",
          "github_push_without_ack",
          "cursor_infinite_chat"
        ]
      },
      "minItems": 1
    },
    "max_steps_per_loop": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 3
    },
    "max_wall_seconds_per_loop": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600,
      "default": 600
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "runner", "argv"],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "runner": {
          "type": "string",
          "enum": ["python", "powershell"]
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 32
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
