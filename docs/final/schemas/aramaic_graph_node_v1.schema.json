{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/aramaic_graph_node_v1.schema.json",
  "title": "Aramaic graph node v1 (B-track JSONL row)",
  "description": "One JSON object per line in aramaic_graph_nodes_v1.jsonl. Aligns with scripts/build_aramaic_graph_nodes_v1.py and scripts/build_aramaic_cross_corpus_bridge_v1.py.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "node_id",
    "corpus",
    "ref",
    "text_norm",
    "time_bucket",
    "theme_tags",
    "regime_tags",
    "research_only",
    "promotion_required",
    "source_track"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "aramaic_graph_node_v1"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "corpus": {
      "type": "string",
      "enum": ["aramaic", "hebrew", "greek"]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text_norm": {
      "type": "string",
      "maxLength": 65536
    },
    "time_bucket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "theme_tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 256 }
    },
    "regime_tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 256 }
    },
    "research_only": {
      "type": "boolean",
      "const": true
    },
    "promotion_required": {
      "type": "boolean",
      "const": true
    },
    "source_track": {
      "type": "string",
      "const": "B"
    }
  }
}
