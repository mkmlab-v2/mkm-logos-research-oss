{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/three_lens_sphere_envelope_v1.schema.json",
  "title": "Three-lens magic sphere envelope v1",
  "description": "Read-only UI envelope: Field → Logos/Sasang/Myeongni → conflict → final_action. B-track, NON_GATING for Logos.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "version",
    "ts_utc",
    "labels",
    "hypothesis_tier",
    "boundary_ack",
    "field",
    "lenses",
    "conflict_resolver",
    "final_action",
    "hub_links",
    "inputs_manifest"
  ],
  "properties": {
    "schema": { "type": "string", "const": "three_lens_sphere_envelope_v1" },
    "version": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "ts_utc": { "type": "string" },
    "labels": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "enum": ["HYPO", "NON_GATING", "research_only"] }
    },
    "hypothesis_tier": { "type": "string", "const": "B" },
    "boundary_ack": { "type": "boolean", "const": true },
    "field": {
      "type": "object",
      "required": ["regime_id", "regime_label_ko", "evidence_path"],
      "properties": {
        "regime_id": { "type": "string" },
        "regime_label_ko": { "type": "string" },
        "evidence_path": { "type": "string" },
        "prophecy_headline_active_rate": { "type": ["number", "null"] }
      }
    },
    "lenses": {
      "type": "object",
      "required": ["logos", "sasang", "myeongni"],
      "properties": {
        "logos": { "$ref": "#/definitions/lens_slot" },
        "sasang": { "$ref": "#/definitions/lens_slot" },
        "myeongni": { "$ref": "#/definitions/lens_slot" }
      }
    },
    "conflict_resolver": {
      "type": "object",
      "required": ["summary_ko", "minority_lens_ids", "agreement_rate"],
      "properties": {
        "summary_ko": { "type": "string" },
        "minority_lens_ids": { "type": "array", "items": { "type": "string" } },
        "agreement_rate": { "type": "number" },
        "conflict_count": { "type": "integer" }
      }
    },
    "final_action": {
      "type": "string",
      "enum": ["HOLD", "WATCH", "REDUCE"]
    },
    "hub_links": {
      "type": "object",
      "properties": {
        "jemaai_logos_v6_product": { "type": "string" },
        "jemaai_meaning_topology_graph": { "type": "string" },
        "mkmlife_oracle_sphere": { "type": "string" }
      }
    },
    "graph_viz": {
      "type": "object",
      "properties": {
        "node_count_display": { "type": "integer" },
        "graph_slice_path": { "type": "string" }
      }
    },
    "rag_layers": {
      "type": "object",
      "description": "Pedagogical 4RAG tags only; not a runtime engine.",
      "properties": {
        "lexical": { "type": "array", "items": { "type": "string" } },
        "semantic": { "type": "array", "items": { "type": "string" } },
        "temporal": { "type": "array", "items": { "type": "string" } },
        "constitutional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rag_layers_resolved": {
      "type": "object",
      "description": "4RAG layer SSOT pointers (script + artifact); not a runtime engine.",
      "properties": {
        "lexical": { "type": "array", "items": { "$ref": "#/definitions/rag_layer_resolved_entry" } },
        "semantic": { "type": "array", "items": { "$ref": "#/definitions/rag_layer_resolved_entry" } },
        "temporal": { "type": "array", "items": { "$ref": "#/definitions/rag_layer_resolved_entry" } },
        "constitutional": { "type": "array", "items": { "$ref": "#/definitions/rag_layer_resolved_entry" } }
      }
    },
    "inputs_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "present"],
        "properties": {
          "path": { "type": "string" },
          "present": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "rag_layer_resolved_entry": {
      "type": "object",
      "required": ["tag", "artifact_path", "present", "resolved_at_utc"],
      "properties": {
        "tag": { "type": "string" },
        "artifact_path": { "type": "string" },
        "present": { "type": "boolean" },
        "resolved_at_utc": { "type": "string" },
        "script_path": { "type": "string" },
        "script_present": { "type": "boolean" }
      }
    },
    "lens_slot": {
      "type": "object",
      "required": ["available", "title_ko", "body_ko", "artifact_path"],
      "properties": {
        "available": { "type": "boolean" },
        "title_ko": { "type": "string" },
        "body_ko": { "type": "string" },
        "direction_sign": { "type": "string" },
        "confidence": { "type": ["number", "null"] },
        "non_gating": { "type": "boolean" },
        "artifact_path": { "type": "string" },
        "evidence_tier": { "type": "string" }
      }
    }
  }
}
