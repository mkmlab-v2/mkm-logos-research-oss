{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkm.local/schemas/a2a_target_points_v1.schema.json",
  "title": "A2A target points v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "final_action",
    "boundary_ack",
    "compress_skip_rules_v1",
    "target_points",
    "excluded_surfaces",
    "evidence_paths"
  ],
  "properties": {
    "schema": { "const": "a2a_target_points_v1" },
    "version": { "type": "string" },
    "status": { "enum": ["WATCH_WIRE_PROFILE", "PILOT_ALL_THREE_TP", "ACTIVE_PILOT", "RETIRED"] },
    "research_only": { "type": "boolean" },
    "hypothesis_tier": { "enum": ["B"] },
    "final_action": { "type": "string" },
    "boundary_ack": { "type": "string" },
    "wire_profile_ssot": { "type": "string" },
    "generated_at_utc": { "type": "string" },
    "compress_skip_rules_v1": {
      "type": "object",
      "required": ["status", "min_plaintext_tokens_recommend", "boundary_ack"],
      "properties": {
        "status": { "type": "string" },
        "min_plaintext_tokens_recommend": { "type": "integer", "minimum": 0 },
        "max_evaluate_report_ms_without_roi_hypothesis": { "type": "number" },
        "rationale": { "type": "string" },
        "evidence_artifact_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "target_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "title_ko",
          "lane",
          "status",
          "input",
          "output",
          "a2a_wire",
          "skip_rules",
          "pytest_paths",
          "roi_hypothesis"
        ],
        "properties": {
          "id": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "title_ko": { "type": "string" },
          "lane": { "type": "string" },
          "status": { "enum": ["WATCH", "PILOT", "WIRED"] },
          "input": { "type": "object" },
          "output": { "type": "object" },
          "a2a_wire": { "type": "object" },
          "skip_rules": { "type": "object" },
          "pytest_paths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "roi_hypothesis": { "type": "object" },
          "excluded_from": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "excluded_surfaces": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "measured_kpi_snapshot": { "type": "object" }
  },
  "additionalProperties": true
}
