{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/market_sasang_lens_output_v1.schema.json",
  "title": "Market Sasang lens v1 output",
  "description": "B-track market only: 4-quadrant softmax state, uncertainty, veto for coordinator / independent_lens_fusion stub. No LLM. Not clinical.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "version",
    "ts_utc",
    "lens_id",
    "engine_id",
    "hypothesis_tier",
    "boundary_ack",
    "a_track_autotrigger_forbidden",
    "clinical_bridge_forbidden",
    "human_commander_gate_v1",
    "policy",
    "state_vector_sasang_softmax",
    "state_vector_sum_check",
    "uncertainty",
    "veto",
    "fusion_bridge",
    "provenance"
  ],
  "properties": {
    "schema": { "type": "string", "const": "market_sasang_lens_v1" },
    "version": { "type": "string" },
    "ts_utc": { "type": "string" },
    "lens_id": { "type": "string", "const": "market_sasang" },
    "engine_id": { "type": "string" },
    "hypothesis_tier": { "type": "string", "const": "B" },
    "boundary_ack": { "type": "boolean", "const": true },
    "a_track_autotrigger_forbidden": { "type": "boolean", "const": true },
    "clinical_bridge_forbidden": { "type": "boolean", "const": true },
    "human_commander_gate_v1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "version", "track", "banner_ko", "final_authority", "machine_output_role"],
      "properties": {
        "schema": { "type": "string", "const": "human_commander_gate_v1" },
        "version": { "type": "string" },
        "track": { "type": "string", "const": "B" },
        "banner_ko": { "type": "string", "minLength": 1 },
        "final_authority": { "type": "string", "const": "human_commander" },
        "machine_output_role": {
          "type": "string",
          "const": "decision_support_observation_only"
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["schema", "version", "policy_path"],
      "properties": {
        "schema": { "type": "string" },
        "version": { "type": "string" },
        "policy_path": { "type": "string" }
      }
    },
    "state_vector_sasang_softmax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taeyang", "soyang", "taeeum", "soeum"],
      "properties": {
        "taeyang": { "type": "number", "minimum": 0, "maximum": 1 },
        "soyang": { "type": "number", "minimum": 0, "maximum": 1 },
        "taeeum": { "type": "number", "minimum": 0, "maximum": 1 },
        "soeum": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "state_vector_sum_check": { "type": "number", "minimum": 0.99, "maximum": 1.01 },
    "uncertainty": {
      "type": "object",
      "required": ["entropy_norm_4way", "upstream_lens_confidence", "composite_uncertainty"],
      "properties": {
        "entropy_norm_4way": { "type": "number", "minimum": 0, "maximum": 1 },
        "upstream_lens_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "composite_uncertainty": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "veto": {
      "type": "object",
      "required": ["force_hold", "reason_codes", "veto_policy_version"],
      "properties": {
        "force_hold": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "veto_policy_version": { "type": "string" }
      }
    },
    "fusion_bridge": {
      "type": "object",
      "required": ["compatible_with", "direction_hint", "score_hint", "use_in_fusion_inputs"],
      "properties": {
        "compatible_with": {
          "type": "array",
          "items": { "type": "string" }
        },
        "direction_hint": {
          "type": "string",
          "enum": ["bull", "bear", "neutral"]
        },
        "score_hint": { "type": "number", "minimum": -1, "maximum": 1 },
        "use_in_fusion_inputs": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["upstream_artifact_path", "upstream_lens_schema"],
      "properties": {
        "upstream_artifact_path": { "type": "string" },
        "upstream_lens_schema": { "type": ["string", "null"] }
      }
    }
  }
}
