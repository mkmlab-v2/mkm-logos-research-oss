{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkm.local/schemas/mkm_life_anchor_os_kernel_skins_v1.schema.json",
  "title": "mkm_life_anchor_os_kernel_skins_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "generated_at_utc",
    "hypothesis_tier",
    "research_only",
    "auto_apply",
    "kernel",
    "skins",
    "forbidden_fusion_modes",
    "forbidden_claims_ko",
    "public_facing_ref"
  ],
  "properties": {
    "schema": { "const": "mkm_life_anchor_os_kernel_skins_v1" },
    "version": { "type": "string", "pattern": "^1\\." },
    "generated_at_utc": { "type": "string" },
    "hypothesis_tier": { "const": "B" },
    "research_only": { "const": true },
    "auto_apply": { "const": "none" },
    "tagline_ko": { "type": "string", "maxLength": 512 },
    "tagline_en": { "type": "string", "maxLength": 512 },
    "kernel": { "$ref": "#/$defs/kernel" },
    "skins": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/skin" }
    },
    "forbidden_fusion_modes": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/forbidden_mode" }
    },
    "forbidden_claims_ko": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "maxLength": 256 }
    },
    "public_facing_ref": { "type": "string" },
    "track_c_ref": { "type": "string" },
    "domain_portfolio_ref": { "type": "string" }
  },
  "$defs": {
    "kernel_module": {
      "type": "object",
      "required": ["module_id", "label_ko", "ssot_refs"],
      "properties": {
        "module_id": { "type": "string" },
        "label_ko": { "type": "string" },
        "ssot_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rag_graph_runtime": { "type": "boolean" }
      }
    },
    "kernel": {
      "type": "object",
      "required": ["label_ko", "modules", "layer_contract"],
      "properties": {
        "label_ko": { "type": "string" },
        "modules": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/kernel_module" }
        },
        "layer_contract": {
          "type": "object",
          "required": ["layer_a", "layer_b"],
          "properties": {
            "layer_a": {
              "type": "object",
              "required": ["role", "rag_graph_runtime"],
              "properties": {
                "role": { "const": "profile_ssot_sequential" },
                "rag_graph_runtime": { "const": false }
              }
            },
            "layer_b": {
              "type": "object",
              "required": ["role", "rag_graph_runtime", "enable_query_flag"],
              "properties": {
                "role": { "const": "explore_showroom_optional" },
                "rag_graph_runtime": { "const": false },
                "enable_query_flag": { "const": "explore=1" }
              }
            }
          }
        }
      }
    },
    "skin": {
      "type": "object",
      "required": ["skin_id", "domain", "label_ko", "role_ko", "cta_ko", "upstream_kernel_modules"],
      "properties": {
        "skin_id": {
          "type": "string",
          "enum": ["mkmlife", "personadiary", "jemaai_cloud", "jema_ai_b2b"]
        },
        "domain": { "type": "string" },
        "label_ko": { "type": "string" },
        "role_ko": { "type": "string", "maxLength": 512 },
        "cta_ko": { "type": "string", "maxLength": 256 },
        "cta_href": { "type": "string" },
        "ssot_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "upstream_kernel_modules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "forbidden_ko": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "forbidden_mode": {
      "type": "object",
      "required": ["mode_id", "label_ko", "reason_ko"],
      "properties": {
        "mode_id": { "type": "string" },
        "label_ko": { "type": "string" },
        "reason_ko": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
