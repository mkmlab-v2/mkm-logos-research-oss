{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkm.local/schemas/coding_intent_link_v1.schema.json",
  "title": "Coding intent link v1 (git ↔ checkpoint ↔ gate)",
  "type": "object",
  "required": [
    "schema",
    "recorded_at_utc",
    "link_id",
    "git",
    "checkpoint",
    "gate",
    "link_ok",
    "research_only"
  ],
  "properties": {
    "schema": { "const": "coding_intent_link_v1" },
    "recorded_at_utc": { "type": "string" },
    "link_id": { "type": "string", "minLength": 8 },
    "mission_id": { "type": "string" },
    "note": { "type": "string" },
    "research_only": { "const": true },
    "link_ok": { "type": "boolean" },
    "git": {
      "type": "object",
      "required": ["head_sha", "branch", "subject", "dirty"],
      "properties": {
        "head_sha": { "type": "string", "minLength": 7 },
        "branch": { "type": "string" },
        "subject": { "type": "string" },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["present", "stamp_utc", "message", "central_path"],
      "properties": {
        "present": { "type": "boolean" },
        "stamp_utc": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "central_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["ran", "command", "exit_code", "ok"],
      "properties": {
        "ran": { "type": "boolean" },
        "command": { "type": ["string", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "ok": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diff_summary": {
      "type": "object",
      "required": ["scope", "file_count", "total_insertions", "total_deletions", "files"],
      "properties": {
        "scope": { "enum": ["working_tree", "last_commit"] },
        "file_count": { "type": "integer", "minimum": 0 },
        "total_insertions": { "type": "integer", "minimum": 0 },
        "total_deletions": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "insertions", "deletions"],
            "properties": {
              "path": { "type": "string" },
              "insertions": { "type": "integer", "minimum": 0 },
              "deletions": { "type": "integer", "minimum": 0 },
              "intent_ref": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "hunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "old_start", "new_start"],
            "properties": {
              "path": { "type": "string" },
              "old_start": { "type": "integer", "minimum": 0 },
              "old_lines": { "type": "integer", "minimum": 0 },
              "new_start": { "type": "integer", "minimum": 0 },
              "new_lines": { "type": "integer", "minimum": 0 },
              "intent_ref": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
