{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/bible_meaning_graph_node_v1.schema.json",
  "title": "Bible meaning graph node v1 (JSONL row)",
  "description": "Theme/regime projection nodes from scripts/build_bible_meaning_graph_v1.py (verse nodes may use aramaic_graph_node_v1 and are not validated by this schema).",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "node_id", "kind", "label"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bible_meaning_graph_node_v1"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "type": "string",
      "enum": ["theme", "regime", "verse"]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
