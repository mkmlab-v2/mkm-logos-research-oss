{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/lens_music_symbolic_audio_promotion_gate_v1.schema.json",
  "title": "Lens music symbolic audio — B-track research promotion gate v1",
  "description": "Result of check_lens_music_symbolic_audio_promotion_gate_v1.py. GO decision means CI/pytest bundle passed (M0–M5) and M31 guard did not emit HOLD under the active profile — research-ready within §3.9 only; not Track A commercial audio. Optional promotion_process mirrors shell exit (strict + HOLD_M31 => process_exit_code 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "pytest_exit_code",
    "pytest_pass",
    "decision",
    "track_wall",
    "milestones_ack"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "lens_music_symbolic_audio_promotion_gate_v1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "pytest_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pytest_exit_code": {
      "type": "integer"
    },
    "pytest_pass": {
      "type": "boolean"
    },
    "pytest_log_tail": {
      "type": "string",
      "maxLength": 15000
    },
    "decision": {
      "type": "string",
      "enum": [
        "B_TRACK_RESEARCH_PROMOTION_READY",
        "HOLD_PYTEST_FAILED",
        "HOLD_M31_HORMONE_GUARD"
      ]
    },
    "track_wall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_to_a_track_commercial_audio",
        "promotion_to_track_c_primary_gtm",
        "human_review_required_for_any_public_claim"
      ],
      "properties": {
        "promotion_to_a_track_commercial_audio": { "type": "boolean", "const": false },
        "promotion_to_track_c_primary_gtm": { "type": "boolean", "const": false },
        "human_review_required_for_any_public_claim": { "type": "boolean", "const": true },
        "note": { "type": "string", "maxLength": 4000 }
      }
    },
    "milestones_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M0", "M1", "M2", "M3_schema", "M4_jsonl_batch", "M5_emotion_va_overlay"],
      "properties": {
        "M0": { "type": "boolean" },
        "M1": { "type": "boolean" },
        "M2": { "type": "boolean" },
        "M3_schema": { "type": "boolean" },
        "M4_jsonl_batch": { "type": "boolean" },
        "M5_emotion_va_overlay": { "type": "boolean" }
      }
    },
    "references_ssot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track_c_section": { "type": "string" },
        "compression_playbook_cross_ref": { "type": "string" },
        "track_c_section_3_10_emotion_va": { "type": "string" }
      }
    },
    "emotion_va_overlay_ack": {
      "type": "object",
      "description": "§3.10 emotion VA is covered by the same pytest bundle; does not add a separate gate criterion.",
      "additionalProperties": false,
      "required": [
        "pytest_includes_emotion_va_overlay_tests",
        "does_not_gate_promotion_decision"
      ],
      "properties": {
        "pytest_includes_emotion_va_overlay_tests": {
          "type": "boolean",
          "const": true
        },
        "does_not_gate_promotion_decision": {
          "type": "boolean",
          "const": true
        },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "m31_hormone_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_present", "guard_mode", "passed", "reason", "trend_state", "thresholds"],
      "properties": {
        "input_present": { "type": "boolean" },
        "guard_mode": { "type": "string", "enum": ["soft", "required"] },
        "passed": { "type": "boolean" },
        "reason": { "type": "string" },
        "trend_state": { "type": "string" },
        "high_stress_rate": { "type": ["number", "null"] },
        "max_consecutive_high_stress": { "type": ["integer", "null"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rate_pass": { "type": "boolean" },
            "consecutive_pass": { "type": "boolean" },
            "trend_state_pass": { "type": "boolean" }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_high_stress_rate", "max_consecutive_high_stress"],
          "properties": {
            "max_high_stress_rate": { "type": "number" },
            "max_consecutive_high_stress": { "type": "integer" }
          }
        },
        "non_biological_notice": { "type": "string" },
        "invocation": {
          "type": "object",
          "description": "W3 audit: CLI profile and thresholds used for m31_hormone_guard.",
          "additionalProperties": false,
          "required": [
            "profile",
            "require_m31_input",
            "m31_max_high_stress_rate",
            "m31_max_consecutive_high_stress",
            "hormone_trend_json"
          ],
          "properties": {
            "profile": { "type": "string", "enum": ["strict", "soft"] },
            "require_m31_input": { "type": "boolean" },
            "m31_max_high_stress_rate": { "type": "number" },
            "m31_max_consecutive_high_stress": { "type": "integer" },
            "hormone_trend_json": { "type": "string", "maxLength": 4096 }
          }
        }
      }
    },
    "promotion_process": {
      "type": "object",
      "description": "Shell exit alignment: strict + HOLD_M31 => process_exit_code 1; pytest_pass mirrors pytest only.",
      "additionalProperties": false,
      "required": ["m31_profile", "process_exit_code", "process_pass", "pytest_pass"],
      "properties": {
        "m31_profile": { "type": "string", "enum": ["strict", "soft"] },
        "process_exit_code": { "type": "integer", "minimum": 0, "maximum": 1 },
        "process_pass": { "type": "boolean" },
        "pytest_pass": { "type": "boolean" }
      }
    }
  }
}
