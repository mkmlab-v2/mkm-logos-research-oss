{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkm.local/schemas/showroom_macro_horizon_2030_slice_v1.schema.json",
  "title": "showroom_macro_horizon_2030_slice_v1",
  "description": "Read-only showroom slice derived from logos_macro_horizon_2030_scenario_v1. Track B [HYPO]; no trade signals or price targets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "stale_after_utc",
    "hypo_banner",
    "summary_one_line",
    "source_ref",
    "no_trade_signals",
    "disclaimer_ref",
    "final_action",
    "field_primary",
    "macro_badges",
    "btc_path",
    "phase_bands",
    "logos_era_overlay",
    "boundary_ack"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "showroom_macro_horizon_2030_slice_v1"
    },
    "generated_at_utc": { "type": "string", "minLength": 10 },
    "stale_after_utc": { "type": "string", "minLength": 10 },
    "hypo_banner": { "type": "string", "minLength": 6 },
    "summary_one_line": { "type": "string", "maxLength": 500 },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "generated_at_utc"],
      "properties": {
        "path": { "type": "string", "minLength": 4 },
        "schema": { "type": "string", "const": "logos_macro_horizon_2030_scenario_v1" },
        "generated_at_utc": { "type": "string", "minLength": 10 },
        "scenario_kind": { "type": "string" }
      }
    },
    "no_trade_signals": { "type": "boolean", "const": true },
    "disclaimer_ref": { "type": "string", "minLength": 4 },
    "final_action": { "type": "string", "minLength": 2 },
    "field_primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime_id", "decision_state", "risk_warning_level"],
      "properties": {
        "regime_id": { "type": "string" },
        "decision_state": { "type": "string" },
        "risk_warning_level": { "type": "string" }
      }
    },
    "macro_badges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["badge_id", "label_ko", "value_display", "value_kind"],
        "properties": {
          "badge_id": { "type": "string" },
          "label_ko": { "type": "string" },
          "value_display": { "type": "string" },
          "value_kind": {
            "type": "string",
            "enum": ["registry_p", "risk_signal", "heuristic_weight"]
          },
          "source_question_id": { "type": "string" },
          "non_gating": { "type": "boolean" }
        }
      }
    },
    "btc_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "base_weight", "stress_weight", "operator_posture", "not_calibrated"],
      "properties": {
        "axis_id": { "type": "string" },
        "base_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "stress_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "operator_posture": { "type": "string" },
        "not_calibrated": { "type": "boolean", "const": true }
      }
    },
    "phase_bands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "label_ko"],
        "properties": {
          "phase_id": { "type": "string" },
          "label_ko": { "type": "string" },
          "focus": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "logos_era_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secondary_label_ko", "non_gating"],
      "properties": {
        "secondary_label_ko": { "type": "string" },
        "secondary_era_id": { "type": "string" },
        "non_gating": { "type": "boolean", "const": true }
      }
    },
    "boundary_ack": { "type": "string", "minLength": 10 }
  }
}
