{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkm.local/schemas/edge_encoder_coord_wire_v1.schema.json",
  "title": "Edge encoder on-wire coord payload v1",
  "description": "SKU-COORD minimal wire — base fingerprint + coord_inject only; no original bulk.",
  "type": "object",
  "required": [
    "sku_class",
    "wire_mode",
    "base_asset_id",
    "base_sha256",
    "coord_inject"
  ],
  "additionalProperties": true,
  "properties": {
    "sku_class": { "const": "coord" },
    "wire_mode": { "const": "anatomy_overlay_coord_v1" },
    "base_asset_id": { "type": "string", "minLength": 8 },
    "base_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coord_inject": {
      "type": "object",
      "required": ["entry_id", "layer_id", "coord_spec", "points_norm"],
      "additionalProperties": true,
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "layer_id": { "type": "string", "minLength": 1 },
        "coord_spec": { "type": "string", "minLength": 1 },
        "points_norm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "stroke": { "type": "string" },
        "label_text": { "type": "string" }
      }
    }
  }
}
