{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/mkm_bianzheng_tri_layer_v1.schema.json",
  "title": "MKM Bianzheng tri-layer payload v1 (A engine / B augmentation / C display)",
  "description": "Standalone or nested under km_physician_cds_assist_envelope_v1.mkm_bianzheng_tri_layer. Layer A = deterministic engine hypotheses only; layer B = western/literature augmentation non-diagnostic; layer C = visualization/disclaimer metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "layer_a_engine",
    "layer_b_augmentation",
    "layer_c_display_meta"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "mkm_bianzheng_tri_layer_v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "layer_a_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "engine_version",
        "input_schema_id",
        "input_schema_version",
        "ruleset_id",
        "ruleset_version",
        "run_id",
        "generated_at_utc",
        "deterministic_input_sha256",
        "candidate_list"
      ],
      "properties": {
        "engine_id": { "type": "string", "minLength": 1 },
        "engine_version": { "type": "string", "minLength": 1 },
        "input_schema_id": { "type": "string", "minLength": 1 },
        "input_schema_version": { "type": "string", "minLength": 1 },
        "ruleset_id": { "type": "string", "minLength": 1 },
        "ruleset_version": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "generated_at_utc": {
          "type": "string",
          "description": "ISO-8601 instant (UTC recommended).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "deterministic_input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engine_trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps"],
          "properties": {
            "step_log_ref": { "type": "string" },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["step_id", "rule_ref", "inputs_digest_sha256", "output_digest_sha256"],
                "properties": {
                  "step_id": { "type": "string", "minLength": 1 },
                  "rule_ref": { "type": "string", "minLength": 1 },
                  "inputs_digest_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "output_digest_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "candidate_list": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "kind",
              "label",
              "score_0_1",
              "rank",
              "hypothesis_scope"
            ],
            "properties": {
              "candidate_id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": [
                  "constitution_pattern",
                  "syndrome_pattern",
                  "formula_hypothesis",
                  "other"
                ]
              },
              "label": { "type": "string", "minLength": 1 },
              "score_0_1": { "type": "number", "minimum": 0, "maximum": 1 },
              "rank": { "type": "integer", "minimum": 0 },
              "hypothesis_scope": {
                "type": "string",
                "const": "engine_hypothesis_only"
              },
              "feature_vector_ref": { "type": "string" },
              "derivation_notes_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "layer_b_augmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["western_med_fallback", "literature_evidence"],
      "properties": {
        "western_med_fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding",
            "risk_gate",
            "differential_hypotheses",
            "contraindication_flags",
            "escalation_prompts"
          ],
          "properties": {
            "binding": {
              "type": "string",
              "const": "reference_only_non_diagnostic"
            },
            "risk_gate": {
              "type": "string",
              "enum": ["GO", "WATCH", "HOLD"]
            },
            "gate_rationale_ref": { "type": "string" },
            "differential_hypotheses": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hypothesis_id", "label", "hypothesis_only", "urgency"],
                "properties": {
                  "hypothesis_id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "hypothesis_only": { "type": "boolean", "const": true },
                  "urgency": {
                    "type": "string",
                    "enum": [
                      "routine",
                      "urgent",
                      "emergency_evaluate_local_protocol"
                    ]
                  }
                }
              }
            },
            "contraindication_flags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "escalation_prompts": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "literature_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "corpus_id",
              "corpus_snapshot_version",
              "chunk_id",
              "snippet_hash_sha256",
              "evidence_grade",
              "claim_scope"
            ],
            "properties": {
              "evidence_id": { "type": "string", "minLength": 1 },
              "corpus_id": { "type": "string", "minLength": 1 },
              "corpus_snapshot_version": { "type": "string", "minLength": 1 },
              "chunk_id": { "type": "string", "minLength": 1 },
              "snippet_hash_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_grade": {
                "type": "string",
                "enum": [
                  "guideline",
                  "primary_lit",
                  "secondary_lit",
                  "other"
                ]
              },
              "claim_scope": {
                "type": "string",
                "enum": ["supporting", "contrasting", "safety_only"]
              },
              "uri": { "type": "string" },
              "retrieved_at_utc": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
              }
            }
          }
        }
      }
    },
    "layer_c_display_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "disclaimer_flags", "locale"],
      "properties": {
        "audience": {
          "type": "string",
          "enum": ["clinician_workstation", "public_showroom", "mixed_bundle"]
        },
        "visualization_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hypothesis_space_projection_id",
            "projection_model_id",
            "projection_version",
            "axes",
            "coordinates_by_candidate_id",
            "uncertainty_band"
          ],
          "properties": {
            "hypothesis_space_projection_id": { "type": "string", "minLength": 1 },
            "projection_model_id": { "type": "string", "minLength": 1 },
            "projection_version": { "type": "string", "minLength": 1 },
            "axes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["axis_id", "label_key"],
                "properties": {
                  "axis_id": { "type": "string", "minLength": 1 },
                  "label_key": { "type": "string", "minLength": 1 },
                  "unit": { "type": "string" }
                }
              }
            },
            "coordinates_by_candidate_id": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "number" }
              }
            },
            "uncertainty_band": {
              "type": "string",
              "enum": ["none", "interval", "ensemble_spread"]
            }
          }
        },
        "copy_safe_summary_ref": { "type": "string" },
        "disclaimer_flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require_physician_review_banner",
            "not_emergency_disposition",
            "no_automatic_prescription",
            "western_layer_non_gating",
            "public_redaction_mode"
          ],
          "properties": {
            "require_physician_review_banner": { "type": "boolean" },
            "not_emergency_disposition": { "type": "boolean" },
            "no_automatic_prescription": { "type": "boolean" },
            "western_layer_non_gating": { "type": "boolean" },
            "public_redaction_mode": { "type": "boolean" }
          }
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "description": "BCP 47 language tag, e.g. ko-KR."
        }
      }
    }
  }
}
