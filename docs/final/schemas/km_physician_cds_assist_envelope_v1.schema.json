{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/km_physician_cds_assist_envelope_v1.schema.json",
  "title": "Korean medicine physician CDS assist envelope v1",
  "description": "Structured clinical decision support output for licensed physicians. Not standalone diagnosis or prescription; physician retains final judgment. Pair with RAG corpus versioning + audit logs in deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "intent",
    "boundary_ack",
    "role_contract",
    "clinical_question",
    "evidence_assessment",
    "evidence_items",
    "human_physician_review_required",
    "disclaimer_ack"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "km_physician_cds_assist_envelope_v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "intent": {
      "type": "string",
      "const": "physician_clinical_decision_support"
    },
    "boundary_ack": {
      "type": "boolean",
      "const": true,
      "description": "Producer asserts CDS boundaries were enforced in generation."
    },
    "role_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cds_only_not_standalone_diagnosis",
        "physician_final_authority",
        "not_emergency_disposition_final"
      ],
      "properties": {
        "cds_only_not_standalone_diagnosis": { "type": "boolean", "const": true },
        "physician_final_authority": { "type": "boolean", "const": true },
        "not_emergency_disposition_final": { "type": "boolean", "const": true }
      }
    },
    "patient_context_summary": {
      "type": "string",
      "description": "Short structured summary; minimize PHI per hospital policy.",
      "maxLength": 8000
    },
    "clinical_question": {
      "type": "string",
      "minLength": 4,
      "description": "The precise clinician-framed question this CDS pass answers."
    },
    "evidence_assessment": {
      "type": "string",
      "enum": ["sufficient", "partial", "insufficient"],
      "description": "Coverage of institutional/guideline corpus for this query."
    },
    "evidence_gap_notes": {
      "type": "string",
      "description": "Required when evidence_assessment is partial or insufficient.",
      "maxLength": 4000
    },
    "evidence_items": {
      "type": "array",
      "description": "Citation-backed items retrieved or curated for the physician; may be empty only when insufficient + gap notes explain.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence_grade", "citation"],
        "properties": {
          "claim": { "type": "string", "minLength": 2 },
          "evidence_grade": {
            "type": "string",
            "enum": [
              "guideline",
              "textbook",
              "primary_lit",
              "secondary_lit",
              "internal_protocol",
              "encyclopedic_ref",
              "other"
            ]
          },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "chunk_ref": { "type": "string" },
              "document_version": { "type": "string" },
              "retrieved_at_utc": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
              },
              "uri": { "type": "string" }
            }
          },
          "relevance": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "notes": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "differential_framework": {
      "type": "array",
      "description": "Non-final differential scaffolding; labels are hypotheses for physician review.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "hypothesis_only"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "hypothesis_only": { "type": "boolean", "const": true },
          "supporting_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mitigating_or_contraindicating_points": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "red_flags_and_escalation": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Safety nets; do not replace clinician judgment."
    },
    "suggested_next_steps_for_physician": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Workflow prompts (labs, imaging consult), not patient-facing orders."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_0_1", "rationale"],
      "properties": {
        "overall_0_1": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 4 }
      }
    },
    "human_physician_review_required": {
      "type": "boolean",
      "const": true
    },
    "rag_manifest": {
      "type": "array",
      "description": "Which corpus slices were eligible at generation time.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["corpus_id"],
        "properties": {
          "corpus_id": { "type": "string" },
          "snapshot_version": { "type": "string" },
          "chunk_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pipeline_run_id": { "type": "string" },
        "generator_model": { "type": "string" },
        "deterministic_input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "disclaimer_ack": {
      "type": "string",
      "minLength": 24,
      "description": "Explicit acknowledgement string stored with each artifact for audit."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_assessment": { "enum": ["partial", "insufficient"] } },
        "required": ["evidence_assessment"]
      },
      "then": { "required": ["evidence_gap_notes"], "properties": { "evidence_gap_notes": { "minLength": 8 } } }
    }
  ]
}
