{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/logos_chronology_dynamic_map_v1.schema.json",
  "title": "Logos chronology dynamic map v1 (B-track observational)",
  "description": "Maps a macro observation snapshot to chronology era candidates. research_only, non_gating, [HYPO]. Not trading signals or prophecy certainty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "policy",
    "hypothesis_tier",
    "inputs",
    "inferred_regime_tags",
    "era_ranking",
    "primary_match"
  ],
  "properties": {
    "schema": { "type": "string", "const": "logos_chronology_dynamic_map_v1" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_only", "non_gating", "no_trading_signal"],
      "properties": {
        "research_only": { "type": "boolean", "const": true },
        "non_gating": { "type": "boolean", "const": true },
        "no_trading_signal": { "type": "boolean", "const": true }
      }
    },
    "hypothesis_tier": { "type": "string", "enum": ["[HYPO]"] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chronology_json", "macro_json"],
      "properties": {
        "chronology_json": { "type": "string" },
        "macro_json": { "type": "string" },
        "regime_map_json": { "type": "string" }
      }
    },
    "inferred_regime_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "era_ranking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["era_id", "score", "interpretation_class"],
        "properties": {
          "era_id": { "type": "string" },
          "label_ko": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "matched_tags": { "type": "array", "items": { "type": "string" } },
          "matched_bridges": { "type": "integer", "minimum": 0 },
          "interpretation_class": { "type": "string", "enum": ["[HYPO]"] },
          "narrative_hint_ko": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "primary_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["era_id", "interpretation_class", "confidence_band"],
      "properties": {
        "era_id": { "type": "string" },
        "label_ko": { "type": "string" },
        "confidence_band": { "type": "string", "enum": ["low", "medium", "high"] },
        "interpretation_class": { "type": "string", "enum": ["[HYPO]"] },
        "operator_line_ko": { "type": "string", "maxLength": 1000 }
      }
    },
    "probe_optional": {
      "type": "object",
      "description": "Optional logos_vector_resonance_probe shadow rows"
    }
  }
}
