{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "showroom_meaning_topology_graph_slice_v1.schema.json",
  "title": "Showroom meaning topology graph slice v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "research_only",
    "hypothesis_tier",
    "disclaimer",
    "selection",
    "stats",
    "nodes",
    "edges"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "showroom_meaning_topology_graph_slice_v1" },
    "generated_at_utc": { "type": "string", "minLength": 10 },
    "stale_after_utc": { "type": "string" },
    "research_only": { "const": true },
    "hypothesis_tier": { "type": "string", "enum": ["B"] },
    "disclaimer": {
      "type": "object",
      "required": ["evidence_tier", "gating_status", "note_ko"],
      "properties": {
        "evidence_tier": { "const": "hypo_research_only" },
        "gating_status": { "const": "NON_GATING" },
        "no_trade_signals": { "type": "boolean" },
        "note_ko": { "type": "string", "minLength": 8 }
      }
    },
    "selection": {
      "type": "object",
      "required": ["seed_count", "max_nodes", "max_edges", "seed_candidate_ids"],
      "properties": {
        "seed_count": { "type": "integer", "minimum": 1 },
        "max_nodes": { "type": "integer", "minimum": 1 },
        "max_edges": { "type": "integer", "minimum": 0 },
        "seed_candidate_ids": { "type": "array", "items": { "type": "string" } },
        "seed_source_node_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stats": {
      "type": "object",
      "required": ["node_count", "edge_count"],
      "properties": {
        "node_count": { "type": "integer", "minimum": 0 },
        "edge_count": { "type": "integer", "minimum": 0 },
        "kinds": { "type": "object" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "kind": { "type": "string", "enum": ["verse", "theme", "regime", "other"] },
          "corpus": { "type": "string" },
          "ref": { "type": "string" },
          "hub_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "candidate_id": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "dst", "edge_type", "weight"],
        "properties": {
          "src": { "type": "string" },
          "dst": { "type": "string" },
          "edge_type": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
