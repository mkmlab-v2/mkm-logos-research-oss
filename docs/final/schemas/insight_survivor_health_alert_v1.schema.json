{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/insight_survivor_health_alert_v1.schema.json",
  "title": "Insight survivor health alert v1",
  "description": "scripts/alert_insight_survivor_health_v1.py output (Track T, research_only).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at_utc",
    "research_only",
    "promotion_required",
    "source_track",
    "should_alert",
    "reason",
    "latest",
    "webhook"
  ],
  "properties": {
    "schema": { "type": "string", "const": "insight_survivor_health_alert_v1" },
    "generated_at_utc": { "type": "string", "minLength": 10 },
    "research_only": { "type": "boolean", "const": true },
    "promotion_required": { "type": "boolean", "const": true },
    "source_track": { "type": "string", "const": "T" },
    "should_alert": { "type": "boolean" },
    "reason": {
      "type": "string",
      "enum": [
        "insufficient_history",
        "stable_below_threshold",
        "health_drift"
      ]
    },
    "latest": {
      "type": "object",
      "required": ["survivor_count", "survivor_mean_score"],
      "properties": {
        "survivor_count": { "type": "integer", "minimum": 0 },
        "survivor_mean_score": { "type": "number" }
      },
      "additionalProperties": true
    },
    "history_latest_snapshots": { "type": "integer", "minimum": 0 },
    "drift_threshold_mean": { "type": "number", "minimum": 0 },
    "drift_threshold_count": { "type": "integer", "minimum": 0 },
    "deltas": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "prev_latest": { "type": "object", "additionalProperties": true },
    "max_abs_delta": { "type": "number", "minimum": 0 },
    "webhook": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sent", "status"],
      "properties": {
        "sent": { "type": "boolean" },
        "status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
