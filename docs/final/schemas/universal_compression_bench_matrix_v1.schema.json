{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkm12.local/schemas/universal_compression_bench_matrix_v1.schema.json",
  "title": "Universal Compression Bench Matrix registry v1",
  "description": "B-track only. Golden 40 (full_v2_40) is referenced but never mutated by this registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "research_only",
    "golden_set_frozen",
    "lanes",
    "output_contract"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "universal_compression_bench_matrix_registry_v1"
    },
    "generated_at_utc": {
      "type": "string",
      "minLength": 10
    },
    "research_only": {
      "type": "boolean",
      "const": true
    },
    "track_wall": {
      "type": "string"
    },
    "golden_set_frozen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bench_label", "input_path", "active_report_path", "do_not_modify"],
      "properties": {
        "bench_label": { "type": "string", "const": "full_v2_40" },
        "input_path": { "type": "string", "minLength": 1 },
        "active_report_path": { "type": "string", "minLength": 1 },
        "case_count": { "type": "integer", "minimum": 1 },
        "do_not_modify": { "type": "boolean", "const": true }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane_id", "domain_tag", "input_path", "enabled"],
        "properties": {
          "lane_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$" },
          "domain_tag": { "type": "string", "minLength": 1 },
          "input_path": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_input_path", "sweep_report_path", "forbidden_write_paths"],
      "properties": {
        "matrix_input_path": { "type": "string", "minLength": 1 },
        "sweep_report_path": { "type": "string", "minLength": 1 },
        "forbidden_write_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  }
}
