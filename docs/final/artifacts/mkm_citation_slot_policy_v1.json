  "hard_rules": [
    {
      "id": "HR-PRESENCE_NE_VALIDITY",
      "rule": "citation presence != claim validity"
    },
    {
      "id": "HR-FOUND_NE_SUPPORTS",
      "rule": "source found != source supports claim"
    },
    {
      "id": "HR-WORKER_CITE_NE_VERIFIED",
      "rule": "worker-generated citation != verified citation"
    },
    {
      "id": "HR-SEARCH_HIT_NE_AUTHORITY",
      "rule": "search hit != authoritative evidence"
    },
    {
      "id": "HR-INFERENCE_NO_EVIDENCE_SLOT",
      "rule": "model inference cannot occupy an evidence slot as authoritative_path substitute"
    },
    {
      "id": "HR-NO_SILENT_DOWNGRADE_OVERRIDE",
      "rule": "lower-tier source cannot silently override higher-tier source"
    },
    {
      "id": "HR-MISSING_STAYS_MISSING",
      "rule": "missing citation must remain SOURCE_MISSING / UNKNOWN — no filler"
    },
    {
      "id": "HR-NO_FABRICATED_BIB",
      "rule": "no fabricated bibliography / DOI / URL / page number"
    },
    {
      "id": "HR-QUOTE_BOUNDARY",
      "rule": "DIRECT_QUOTE requires exact span; PARAPHRASE must not be labeled QUOTE"
    },
    {
      "id": "HR-CEILING_NO_UPGRADE",
      "rule": "verification_state alone cannot raise evidence_ceiling to SEND/DEPLOY/PRODUCT_DONE"
    },
    {
      "id": "HR-LEDGER_BRIDGE",
      "rule": "optional claim_id/evidence_id may link Evidence Ledger; this policy does not auto-append"
    },
    {
      "id": "HR-ENTITY_BRIDGE",
      "rule": "identity claims should also satisfy Entity/Case Binding when entity is in scope"
    }
  ],
