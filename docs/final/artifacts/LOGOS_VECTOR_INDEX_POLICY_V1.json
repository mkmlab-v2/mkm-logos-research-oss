{
  "schema": "logos_vector_index_policy_v1",
  "version": "1.0.0",
  "hypothesis_tier": "B",
  "purpose": "Track B slice 3 — embedding/ANN knobs before real index build; no production defaults.",
  "status": "active",
  "backend": {
    "preferred": "local_flatfile_or_sqlite_placeholder",
    "forbidden_for_track_a_live": ["remote_uncached_embedding_burst_without_budget"]
  },
  "embedding": {
    "model_id": "sentence-transformers/all-MiniLM-L6-v2",
    "max_chars_per_chunk": 8192,
    "batch_size": 32,
    "normalize_vectors": true
  },
  "retrieval": {
    "top_k_default": 24,
    "max_hops_graph_walk": 8,
    "token_budget_llm_context": 28000,
    "timeout_seconds_offline_job": 14400
  },
  "corpus_alignment": {
    "required_preconditions": [
      "docs/final/artifacts/logos_corpus_manifest_v1_latest.json",
      "docs/final/artifacts/logos_corpus_graph_bundle_v1_latest.json"
    ],
    "dedupe_key_field": "dedupe_bundle_key_sha256"
  },
  "forbidden": {
    "realtime_full_corpus_scan": true,
    "a_track_live_trigger": true
  }
}
