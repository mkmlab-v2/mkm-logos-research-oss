      "neuro": {
        "description": "Input · ask pill · short forms — minimal chrome",
        "antigravity_proposed": {
          "focus_ring": "0 0 0 2px rgba(91, 140, 255, 0.4)",
          "input_height": "{shared_primitive.spacing.xl}"
        }
      },
      "symbolic": {
        "description": "Badges · metrics · tables · artifact paths — dry monospace-friendly",
        "antigravity_proposed": {
          "badge_radius": "{shared_primitive.radius.sm}",
          "metric_strip_gap": "{shared_primitive.spacing.sm}"
        }
      },
      "human": {
        "description": "Disclaimers · CTAs · clinician routing — high contrast labels",
        "antigravity_proposed": {
          "disclaimer_surface": "rgba(10, 18, 16, 0.95)",
          "cta_min_width": "10.2rem"
        }
      }
    }
