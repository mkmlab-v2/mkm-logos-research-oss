    },
    "--hub-bg": {
      "semantic": "trust.hub.bg",
      "locked": true
    },
    "--hub-discover-accent": {
      "semantic": "trust.hub.accent",
      "locked": true
    },
    "--enterprise-glow": {
      "semantic": "trust.saas.glow",
      "locked": true
    },
    "--lr-ask-bg": {
      "semantic": "trust.logos_ask.bg",
      "maps_to": ".logos-research-ask-page"
    },
    "--lr-ask-accent": {
      "semantic": "trust.logos_ask.accent",
      "maps_to": ".logos-research-ask-page"
    },
    "--lr-ask-gold": {
      "semantic": "trust.logos_ask.gold",
