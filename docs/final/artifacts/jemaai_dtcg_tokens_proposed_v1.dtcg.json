    "semantic.jema_os_layer.human.antigravity_proposed",
    "presets.jemaai-marketing-stripe-linear.component.hero.lead-max-width",
    "presets.jemaai-marketing-stripe-linear.component.hero.orb-opacity",
    "presets.jemaai-enterprise-trust.component.metric-strip.value-size",
    "presets.jemaai-enterprise-trust.component.safety-table.cell-padding",
    "presets.jemaai-hub-discover-v3.component.ask-pill.antigravity_proposed",
