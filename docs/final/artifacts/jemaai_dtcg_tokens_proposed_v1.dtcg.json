        "gold": {
          "$value": "{shared_primitive.color.hub-gold-500}",
          "$type": "color",
          "maps_to": "--hub-gold"
        },
        "ink": {
          "$value": "#292524",
          "$type": "color",
          "maps_to": "--hub-discover-ink"
        },
        "muted": {
          "$value": "#64748b",
          "$type": "color",
          "maps_to": "--hub-discover-muted"
        }
      },
      "logos_ask": {
        "description": "logos.jema-ai.com /logos-research/ask — Scriptorium cream/teal/gold (Pack L-Ask v2)",
        "bg": {
          "$value": "#faf7f2",
          "$type": "color",
          "maps_to": "--lr-ask-bg",
          "antigravity_proposed": "#faf7f2"
        },
        "surface": {
          "$value": "#ffffff",
          "$type": "color",
          "maps_to": "--lr-ask-surface",
          "antigravity_proposed": "#ffffff"
        },
        "accent": {
          "$value": "#2d7a68",
          "$type": "color",
          "maps_to": "--lr-ask-accent",
          "antigravity_proposed": "#2d7a68"
        },
        "gold": {
          "$value": "#c5a057",
          "$type": "color",
          "maps_to": "--lr-ask-gold",
          "antigravity_proposed": "#c5a057"
        },
        "ink": {
          "$value": "#292524",
          "$type": "color",
          "maps_to": "--lr-ask-ink",
          "antigravity_proposed": "#292524"
        },
        "ink-soft": {
          "$value": "#57534e",
          "$type": "color",
          "maps_to": "--lr-ask-ink-soft",
          "antigravity_proposed": "#57534e"
        },
        "error": {
          "$value": "#b91c1c",
          "$type": "color",
          "maps_to": "--lr-ask-error",
          "antigravity_proposed": "#b91c1c"
        },
        "error-bg": {
          "$value": "#fef2f2",
          "$type": "color",
          "maps_to": "--lr-ask-error-bg",
