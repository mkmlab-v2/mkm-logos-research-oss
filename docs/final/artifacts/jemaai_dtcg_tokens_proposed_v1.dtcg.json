  "presets": {
    "jemaai-marketing-stripe-linear": {
      "surface_routes": [
        "/",
        "/home"
      ],
      "css_scope": ".preset-stripe-linear",
      "antigravity_pack": "C",
      "semantic_accent_role": "trust.saas",
      "component": {
        "hero": {
          "headline-weight": {
            "$value": 700,
            "$type": "fontWeight"
          },
          "headline-letter-spacing": {
            "$value": "-0.028em",
            "$type": "dimension",
            "maps_to": ".preset-stripe-linear .hero h1"
          },
          "lead-max-width": {
            "$value": "40rem",
            "$type": "dimension",
            "antigravity_proposed": "40rem"
          },
          "orb-opacity": {
            "$value": 0.18,
            "$type": "number",
            "antigravity_proposed": 0.18
          }
        },
        "btn-primary": {
          "bg": {
            "$value": "{semantic.trust.saas.accent}",
            "$type": "color"
          },
          "radius": {
            "$value": "{shared_primitive.radius.md}",
            "$type": "dimension"
          },
          "min-width": {
            "$value": "10.2rem",
            "$type": "dimension",
            "maps_to": ".preset-stripe-linear .hero-cta .btn"
          }
        },
        "proof-strip": {
          "gap": {
            "$value": "{shared_primitive.spacing.sm}",
            "$type": "dimension"
          },
          "font-size": {
            "$value": "{shared_primitive.typography.text-xs}",
            "$type": "dimension"
          }
        }
      }
    },
    "jemaai-enterprise-trust": {
      "surface_routes": [
        "/enterprise",
        "/validation",
        "/safety"
      ],
      "css_scope": ".enterprise-page",
      "antigravity_pack": "D",
      "semantic_accent_role": "trust.saas",
      "component": {
        "eyebrow": {
          "padding-y": {
            "$value": "{shared_primitive.spacing.xs}",
            "$type": "dimension"
          },
          "padding-x": {
            "$value": "{shared_primitive.spacing.md}",
            "$type": "dimension"
          },
          "radius": {
            "$value": "{shared_primitive.radius.pill}",
            "$type": "dimension"
          }
        },
        "metric-strip": {
          "gap": {
            "$value": "{shared_primitive.spacing.sm}",
            "$type": "dimension",
            "maps_to": ".validation-metric-strip"
          },
          "value-size": {
            "$value": "{shared_primitive.typography.text-xl}",
            "$type": "dimension",
            "antigravity_proposed": "{shared_primitive.typography.text-xl}"
          }
        },
        "safety-table": {
          "min-width": {
            "$value": "52rem",
            "$type": "dimension",
            "maps_to": ".safety-lanes-table"
          },
          "cell-padding": {
            "$value": "{shared_primitive.spacing.md}",
            "$type": "dimension",
            "antigravity_proposed": "{shared_primitive.spacing.md}"
          }
        },
        "badge": {
          "radius": {
            "$value": "{shared_primitive.radius.pill}",
            "$type": "dimension",
            "maps_to": ".validation-badge"
          },
          "font": {
            "$value": "ui-monospace, monospace",
            "$type": "fontFamily"
          }
        }
      }
    },
    "jemaai-hub-discover-v3": {
      "surface_routes": [
        "/hub",
        "/hub/*"
      ],
      "css_scope": ".universe-hub-page--light-chrome.universe-hub-page--discover-v3",
      "antigravity_pack": "B",
      "semantic_accent_role": "trust.hub",
      "component": {
        "ask-pill": {
          "radius": {
            "$value": "{shared_primitive.radius.pill}",
            "$type": "dimension"
          },
          "shadow": {
            "$value": "0 1px 2px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06)",
            "$type": "shadow",
            "maps_to": "--hub-pill-shadow"
          },
          "antigravity_proposed": {
            "height": "{shared_primitive.spacing.xl}",
            "focus_ring": "0 0 0 2px rgba(45, 122, 104, 0.4)"
          }
        },
        "inspector-panel": {
          "surface": {
            "$value": "{semantic.trust.hub.bg}",
            "$type": "color",
            "antigravity_proposed": "{semantic.trust.hub.bg}"
          },
          "border": {
            "$value": "{semantic.trust.hub.gold}",
            "$type": "color",
            "antigravity_proposed_opacity": 0.15
          }
        },
        "hub-pill-link": {
          "antigravity_proposed": {
            "padding_y": "{shared_primitive.spacing.xs}",
            "font_size": "{shared_primitive.typography.text-sm}"
          }
        }
      }
    },
    "jemaai-logos-research-ask": {
      "surface_routes": [
        "/logos-research/ask"
      ],
      "css_scope": ".logos-research-ask-page",
      "antigravity_pack": "L-Ask",
      "semantic_accent_role": "trust.logos_ask",
      "component": {
        "citation-lock": {
          "border": {
            "$value": "{semantic.trust.logos_ask.accent}",
            "$type": "color",
            "maps_to": "--lr-ask-accent-border"
          }
        },
        "s4-section": {
          "border-left": {
            "$value": "{semantic.trust.logos_ask.accent}",
            "$type": "color",
            "maps_to": ".lr-ask-s4-section border-left"
          },
          "radius": {
            "$value": "{shared_primitive.radius.md}",
            "$type": "dimension"
          }
        },
        "composer-primary": {
          "bg": {
            "$value": "{semantic.trust.logos_ask.accent}",
            "$type": "color",
            "maps_to": ".logos-research-ask-page .lr-btn-primary"
          }
        }
      }
    }
  },
