  "semantic": {
    "trust": {
      "clinical": {
        "accent": {
          "$value": "{shared_primitive.color.clinical-green-500}",
          "$type": "color",
          "maps_to": ":root --accent"
        },
        "accent-dim": {
          "$value": "{shared_primitive.color.clinical-green-700}",
          "$type": "color"
        }
      },
      "saas": {
        "accent": {
          "$value": "{shared_primitive.color.saas-blue-500}",
          "$type": "color",
          "maps_to": ".preset-stripe-linear --accent"
        },
        "accent-dim": {
          "$value": "{shared_primitive.color.saas-blue-700}",
          "$type": "color",
          "maps_to": ".preset-stripe-linear --accent-dim"
        },
        "glow": {
          "$value": "rgba(91, 140, 255, 0.35)",
          "$type": "color",
          "maps_to": ".enterprise-page --enterprise-glow"
        }
      },
      "hub": {
        "bg": {
          "$value": "{shared_primitive.color.hub-cream-50}",
          "$type": "color",
          "maps_to": "--hub-bg"
        },
        "accent": {
          "$value": "{shared_primitive.color.hub-green-500}",
          "$type": "color",
