{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mkmlife.local/schemas/mkm_study_onboarding_request_v1.json",
  "title": "MKM Study onboarding request v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["student_id", "grade", "sasang_type"],
  "properties": {
    "student_id": { "type": "string", "minLength": 1 },
    "grade": { "type": "string", "minLength": 1 },
    "sasang_type": {
      "type": "string",
      "enum": ["soeum", "soyang", "taeeum", "taeyang", "unknown"]
    },
    "timezone_iana": { "type": "string", "description": "IANA TZ, default Asia/Seoul in servers" },
    "birth_time_known": { "type": "boolean" },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Solar date when clock unknown"
    },
    "birth_datetime": {
      "type": "string",
      "description": "ISO 8601 instant preferred when time known"
    },
    "birth_location": { "type": "string" },
    "gender": { "type": "string", "enum": ["female", "male", "unspecified"] },
    "constitution_survey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stress_response": { "type": "string", "enum": ["internalize", "externalize"] },
        "change_preference": { "type": "string", "enum": ["stability", "challenge"] },
        "sweat_recovery": { "type": "string", "enum": ["fatiguing", "refreshing"] }
      }
    },
    "onboarding_stage": {
      "type": "string",
      "enum": ["minimal", "birth_complete", "extended_complete"]
    },
    "myeongri_profile": { "type": "object" }
  }
}
