{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "btc_frame_governance_stage_payload_v1",
  "title": "BTC frame governance stage payload",
  "description": "Trinity -> Bridge -> Gate operational payload contract with Track A/Track B bulkhead and live-trade guardrails.",
  "type": "object",
  "required": [
    "schema",
    "track",
    "stage",
    "inputs",
    "outputs",
    "risk_gate",
    "evidence",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "btc_frame_governance_stage_payload_v1"
    },
    "track": {
      "type": "string",
      "enum": ["A", "B"],
      "description": "A=operational lane, B=research lane. B cannot trigger live execution."
    },
    "stage": {
      "type": "string",
      "enum": ["trinity", "bridge", "gate"]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "trinity_input": {
          "type": "object",
          "required": ["market_feed_ref", "regime_ref", "lens_bundle_ref"],
          "properties": {
            "market_feed_ref": { "type": "string", "minLength": 1 },
            "regime_ref": { "type": "string", "minLength": 1 },
            "lens_bundle_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "bridge_input": {
          "type": "object",
          "required": ["trinity_ref", "bridge_policy_ref"],
          "properties": {
            "trinity_ref": { "type": "string", "minLength": 1 },
            "bridge_policy_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "gate_input": {
          "type": "object",
          "required": ["bridge_ref", "risk_profile_ref", "execution_mode"],
          "properties": {
            "bridge_ref": { "type": "string", "minLength": 1 },
            "risk_profile_ref": { "type": "string", "minLength": 1 },
            "execution_mode": {
              "type": "string",
              "enum": ["observe", "dry_run", "live"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["action", "confidence_score"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["hold", "reduce", "watch", "go"]
        },
        "position_size_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "veto_reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "stage_output_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "risk_gate": {
      "type": "object",
      "required": [
        "regime_gate_passed",
        "prophecy_wired",
        "human_approval_required",
        "live_allowed"
      ],
      "properties": {
        "regime_gate_passed": { "type": "boolean" },
        "prophecy_wired": {
          "type": "boolean",
          "description": "When true, secondary lenses are wired in a way that forbids live action."
        },
        "human_approval_required": { "type": "boolean" },
        "human_approval_ref": {
          "type": "string",
          "description": "Approval artifact path (for example trading_human_execution_approval_v1 JSON)."
        },
        "live_allowed": { "type": "boolean" },
        "min_conf_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_path", "sha256"],
        "properties": {
          "artifact_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "array",
      "description": "Append-only audit trail. New events are appended; existing rows are immutable.",
      "items": {
        "type": "object",
        "required": ["ts_utc", "actor", "decision", "message"],
        "properties": {
          "ts_utc": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "minLength": 1 },
          "decision": {
            "type": "string",
            "enum": ["hold", "reduce", "watch", "go", "deny"]
          },
          "message": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "trinity" } } },
      "then": {
        "properties": {
          "inputs": { "required": ["trinity_input"] },
          "outputs": { "required": ["stage_output_ref"] }
        }
      }
    },
    {
      "if": { "properties": { "stage": { "const": "bridge" } } },
      "then": {
        "properties": {
          "inputs": { "required": ["bridge_input"] },
          "outputs": { "required": ["stage_output_ref"] }
        }
      }
    },
    {
      "if": { "properties": { "stage": { "const": "gate" } } },
      "then": {
        "properties": {
          "inputs": { "required": ["gate_input"] },
          "outputs": { "required": ["position_size_pct", "stage_output_ref"] }
        }
      }
    },
    {
      "if": { "properties": { "outputs": { "properties": { "action": { "const": "go" } } } } },
      "then": { "properties": { "stage": { "const": "gate" } } }
    },
    {
      "if": { "properties": { "track": { "const": "B" } } },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "action": { "enum": ["hold", "reduce", "watch"] }
            }
          },
          "risk_gate": {
            "properties": {
              "live_allowed": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "risk_gate": { "properties": { "prophecy_wired": { "const": true } } } } },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "action": { "enum": ["hold", "reduce", "watch"] }
            }
          },
          "risk_gate": {
            "properties": {
              "live_allowed": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "risk_gate": { "properties": { "live_allowed": { "const": true } } } } },
      "then": {
        "properties": {
          "track": { "const": "A" },
          "stage": { "const": "gate" },
          "outputs": {
            "properties": {
              "action": { "const": "go" },
              "confidence_score": { "minimum": 0.8 }
            }
          },
          "risk_gate": {
            "required": ["human_approval_ref"],
            "properties": {
              "regime_gate_passed": { "const": true },
              "human_approval_required": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
