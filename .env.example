# --- Cloudflare API (SSOT: workspace .env → User env via sync_required_env_to_user.ps1) ---
# CLOUDFLARE_API_TOKEN=   # Zone DNS Read+Edit token. After editing .env: run projects/bitcoin-trading/ops/windows-rehearsal/sync_required_env_to_user.ps1 then open a new terminal (or restart Cursor).
#                         # Hub deploy 후 edge 캐시 퍼지: 동 토큰에 Zone · Cache Purge 권한 추가(없으면 scripts/Invoke-CloudflareCachePurge_v1.ps1 → 401 → 대시보드 Purge Everything 수동).
#                         # mkmlife.com 무료 메일(Email Routing): Zone Email Routing Rules Edit + Account Email Routing Addresses Edit. 스크립트: scripts/Invoke-CloudflareEmailRoutingSetup_v1.ps1
#                         # 권장 순서(대시보드 우선): (1) 대상 주소에서 MKM_MKMLIFE_SUPPORT_FORWARD_TO 검증 완료 (2) 라우팅 규칙 support@mkmlife.com → 해당 주소 저장 (3) 선택: 위 스크립트로 재현·감사. DNS-only 토큰은 403.
#                         # 권장안(고정): mkmlife.com 수신 MX는 Cloudflare Email Routing 전용으로 둔다. Hostinger "incorrect MX" 메일은 의도적 이전이면 무시·패널에서 호스팅 메일 끄기. Hostinger MX로 되돌리면 CF 포워딩과 둘 다 살릴 수 없음. 상세: docs/final/NO1KMEDI_MKMLIFE_REPO_PATH_SSOT_2026-04-08.md 절 1.3.
# MKM_CLOUDFLARE_ACCOUNT_ID=   # optional; zone API 응답에 account id가 없거나 --zone-id 트러스트 경로일 때 계정 단 API(대상 주소)에 필요. 미설정이면 전체 실행 중 exit 7(account_id_missing). 드라이런은 zone·routing 조회만 할 때 생략 가능.
# MKM_MKMLIFE_SUPPORT_FORWARD_TO=admin@no1kmedi.com   # support@mkmlife.com 포워딩 수신함. 웹 카피 SSOT: projects/no1kmedi/marketing-site/public-copy.json 등.
# CF_API_TOKEN=           # optional alias; if set without CLOUDFLARE_API_TOKEN, sync mirrors to User CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ZONE_ID=     # optional; must match zone name or Invoke-JemaaiCloudCloudflareDnsEnsure_v1.ps1 ignores it

