# --- A-Track KOSPI real-source overlays (optional) ---
# URL mode (JSON numeric payload)
# ATRACK_FOREIGN_FLOW_4W_API_URL=https://example.com/api/foreign-flow-4w
# ATRACK_SEMI_EXPORTS_YOY_API_URL=https://example.com/api/semi-exports-yoy
# ATRACK_HORMUZ_RISK_API_URL=https://example.com/api/hormuz-risk
#
# Fast local mode (no API server): direct numeric values
# ATRACK_FOREIGN_FLOW_4W_VALUE=150000000
# ATRACK_SEMI_EXPORTS_YOY_VALUE=12.5
# ATRACK_HORMUZ_RISK_VALUE=45
# =============================================================================
# Automation / B-Track scoring (optional)
# MKM_WORKSPACE_ROOT=          # Override repo root for scripts/run_waiting_queue_monthly_check.ps1 when not C:\workspace
# MKM_DAILY_THREAD_LOG_PATH=  # Optional: full path to daily multi-chat work log .md (e.g. Obsidian vault), OR a directory (then daily_thread_work_YYYY-MM-DD.md inside it). Default: reports/daily_thread_work_{date}.md under workspace (usually gitignored).
# MKM_WORKSPACE_MAINTENANCE=1  # Truthy (1,true,yes,on): KPI snapshot, ops fusion, monthly check, autopilot chain skip writes; sync_fact_safe_risk_profile no-ops (User or machine env; not loaded by all runners unless set for the task session)
# MKM_HEALTH_FUSION_SKIP_LOGOS_INSIGHT_BUNDLE=1  # When scripts/run_workspace_automation_health.ps1 runs Track C fusion smoke, pass -SkipLogosInsightBundle to Invoke-TrackCMacroDailyFusion_v1 (omit build_logos_insight_bundle step). Truthy: 1,true,yes,on. Use when `-SkipLogosInsightBundle` is not passed on the command line; explicit `-SkipLogosInsightBundle` still passes the flag to Invoke.
# MKM_BTC_DAILY_CSV=           # Yahoo-style BTC daily CSV for build_btrack_prophecy_score_from_ohlcv (multi leg)
# MKM_BTRACK_PROPHECY_CONTEMPLATION_V1=0   # Opt-out only: when unset, B-track daily chain runs the BTC-lane contemplation pre-gate (run_btrack_prophecy_contemplation_v1) whenever -ResearchEvaluationInstrument is btc. Set 0 or false to skip.
# MKM_BTRACK_CONTEMPLATION_USE_GEMINI=1    # After local bundle guards pass, call Gemini reflect (cost); requires GEMINI_API_KEY or GOOGLE_API_KEY. Fails if set without a key.
# MKM_BTRACK_CONTEMPLATION_GEMINI_MODEL=gemini-2.5-flash
# MKM_BTRACK_CONTEMPLATION_THINKING_BUDGET=2048   # 0 disables ThinkingConfig
# MKM_BTRACK_CONTEMPLATION_GEMINI_TIMEOUT_SEC=120
# MKM_BTRACK_CONTEMPLATION_TIMEOUT_SEC=180     # Whole-script wall clock; raise when Gemini reflect is enabled (default 30).
# Not an env var — PowerShell only: scripts/run_btrack_daily_hypothesis_chain.ps1 -SkipProphecyContemplationGemini (or Register-BTrackDailyHypothesisTask.ps1 -SkipProphecyContemplationGemini) forces contemplation step --skip-gemini-reflect even when MKM_BTRACK_CONTEMPLATION_USE_GEMINI=1.
# =============================================================================
# Local secrets hub — copy to C:\workspace\.env (never commit .env)
# Sync to Windows User env: projects/bitcoin-trading/ops/windows-rehearsal/sync_required_env_to_user.ps1
# Only non-empty keys that appear in that script are copied to User scope.
#
# Windows (recommended for sensitive keys): DPAPI store — scripts/Invoke-EncryptedSecretStore.ps1
#   (path %APPDATA%\MKM\secret_store_v1.json). PoC bridge: scripts/security_agent_manager.py.
#   Track A/B compression is NOT the key-encryption contract — CONSTITUTION §1.1.2.
# One-shot readiness (hygiene + store smoke): scripts/Invoke-MkmSecretsHybridReadiness_v1.ps1
# Linux VPS: use repo-outside env — scripts/deploy/linux/mkm-monorepo-vps.env.example
# SSOT: docs/final/LOCAL_VS_VPS_ONE_RULE_WORKFLOW.md — "비밀 키 (로컬 Windows / Linux VPS)"
# =============================================================================

# --- Trading / exchange ---
# 실제 사용: C:\workspace\.env 에 복사 후, BINANCE_* 는 '#' 없이 KEY=value 로만 적기.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
#
# PoC only — Binance Global USDⓈ-M Futures Signal Bot webhook URL (from Binance UI).
# Never commit a real URL. Replace example JSON body per official Signal Bot docs before POST.
# BINANCE_USDM_SIGNAL_WEBHOOK_URL=
# Optional: if Binance documents a shared secret for webhook verification (do not guess format).
# BINANCE_USDM_SIGNAL_WEBHOOK_SECRET=
# Tick→OHLC 봉 (RealtimeTradingWithMonitoring): 초·완료 봉 개수 (기본 60초 봉 48개 후 통합 분석).
# OHLC_BAR_INTERVAL_SEC=
# OHLC_MIN_COMPLETED_BARS=
# Daemon (scripts/start_24h_daemon.py): yaml trading_config first; these override when set.
# Fees (account-side, not set by repo): Binance Futures UI — pay fees with BNB, fee tier/VIP, maker-taker mix in reports.
# Loop caps (optional env overrides for projects/bitcoin-trading/config/trading_config.yaml trading.*):
# BTC_CHECK_INTERVAL=600
# BTC_MAX_TRADES_PER_DAY=8
# TESTNET=
# ENABLE_TRADING=
# 선물 엔진 선택 (bitcoin-trading): 미설정·legacy = RealtimeTradingWithMonitoring / aroon_v1 = 아론 전용 엔진
# BTC_FUTURES_ENGINE=
# AROON_PERIOD=
# AROON_KLINE_INTERVAL=
# AROON_POLL_SEC=
# AROON_ORDER_QTY=
# AROON_MIN_CROSS_GAP=
# Prophecy layer (RealtimeTradingWithMonitoring): DISABLE skips ProphecyStack only — it does
# NOT disable live orders. Live orders still follow ENABLE_TRADING + TESTNET (+ exchange keys).
# DISABLE_PROPHECY_STACK=
# Non-testnet + ProphecyStack active: block _execute_trade unless operator override.
# PROPHECY_FUSION_ALLOW_MAINNET=
#
# A/B arm label (PM2 프로세스별): 체결 레코드에 runtime_strategy_id로 남김 → export_cursor_trade_history_v1.py 분류.
# RUNTIME_STRATEGY_ID=control
# RUNTIME_STRATEGY_ID=btc_prophecy_treatment_v1
#
# Example profiles — copy ONE uncommented set into your real `.env` (keys only; add BINANCE_* yourself).
# Truthy for daemon bools: 1,true,yes,y,on. Prophecy flags: 1,true,yes only.
#
# A) Testnet, monitor only (no orders)
# TESTNET=1
# ENABLE_TRADING=0
# DISABLE_PROPHECY_STACK=
# PROPHECY_FUSION_ALLOW_MAINNET=
#
# B) Testnet, trading on, Prophecy stack on (mainnet fusion guard N/A on testnet)
# TESTNET=1
# ENABLE_TRADING=1
# DISABLE_PROPHECY_STACK=
# PROPHECY_FUSION_ALLOW_MAINNET=
#
# C) Mainnet trading on, stack on, fusion NOT explicitly allowed → _execute_trade blocked when stack loads
# TESTNET=0
# ENABLE_TRADING=1
# DISABLE_PROPHECY_STACK=
# PROPHECY_FUSION_ALLOW_MAINNET=
#
# D) Mainnet trading on, stack on, operator override — fusion path to live orders allowed
# TESTNET=0
# ENABLE_TRADING=1
# DISABLE_PROPHECY_STACK=
# PROPHECY_FUSION_ALLOW_MAINNET=1
#
# E) Mainnet trading on, stack OFF — Prophecy mainnet guard skipped; live orders STILL follow ENABLE_TRADING+keys
# TESTNET=0
# ENABLE_TRADING=1
# DISABLE_PROPHECY_STACK=1
# PROPHECY_FUSION_ALLOW_MAINNET=

