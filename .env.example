# --- N8N / OPS alarms ---
# N8N_ALL_GREEN_WEBHOOK_URL=
# N8N_WEBHOOK_URL=
# OPS_ALARM_WEBHOOK_URL=
# Live rollback check denominator (check_prophecy_live_rollback_v1.py); default 500 if unset.
# MKM_LIVE_ROLLBACK_REFERENCE_USDT=500
# B-track daily chain: run ensemble v2 recommended eval when 1|true|yes|on (or -IncludeEnsembleV2RecommendedEval).
# MKM_BTRACK_ENSEMBLE_V2_DAILY=
# Optional: Panel 24h alert checker failure (Check-ProphecyPanel24hAlerts.ps1); if unset, falls back to OPS_ALARM_WEBHOOK_URL.
# PROPHECY_PANEL_24H_ALERT_WEBHOOK_URL=
# Optional: Prophecy evolution staleness watchdog failure (Invoke-ProphecyEvolutionWatchdog_v1.ps1); falls back to OPS_ALARM_WEBHOOK_URL.
# PROPHECY_EVOLUTION_WATCHDOG_WEBHOOK_URL=
# Optional: VA fusion control integrity audit failure (Run-VaFusionControlIntegrityChain_v1.ps1); falls back to OPS_ALARM_WEBHOOK_URL. Use -SkipWebhook for CI/local without secrets.
# FUSION_CONTROL_INTEGRITY_AUDIT_WEBHOOK_URL=
# Optional: Aramaic insight-cap threshold drift alert POST (scripts/alert_aramaic_insight_cap_threshold_drift_v1.py); falls back to OPS_ALARM_WEBHOOK_URL. Use --dry-run to skip POST.
# ARAMAIC_INSIGHT_CAP_DRIFT_ALERT_WEBHOOK_URL=
# Optional: Track T insight survivor health alert POST when `health_drift` (`scripts/alert_insight_survivor_health_v1.py`); falls back to `OPS_ALARM_WEBHOOK_URL`. Skip POST: CLI `--dry-run`, or chain `-SurvivorHealthAlertDryRun`, or env `MKM_ARAMAIC_SURVIVOR_HEALTH_ALERT_DRY_RUN`=`1`|`true`|`yes` (Process/User/Machine when running `run_aramaic_mvp_chain_v1.ps1`); daily task: `Register-AramaicMvpDailyTask.ps1 -SurvivorHealthAlertDryRun`.
# INSIGHT_SURVIVOR_HEALTH_ALERT_WEBHOOK_URL=
# MKM_ARAMAIC_SURVIVOR_HEALTH_ALERT_DRY_RUN=
# Optional: Lens music M31 hormone trend — WATCH-only JSON webhook (scripts/dispatch_lens_music_hormone_trend_webhook_v1.py). If unset, dispatch is skipped (webhook_not_configured). Advisory B-track only.
# Local POST smoke without User env: `py scripts/dispatch_lens_music_hormone_trend_webhook_v1.py --webhook-url http://127.0.0.1:<port>/...` (non-empty wins over env); or run `pytest tests/test_dispatch_lens_music_hormone_trend_webhook_v1.py`.
# LENS_MUSIC_HORMONE_WEBHOOK_URL=
# Optional: Cross-lens RAG Track B alert (send_cross_lens_rag_alert_v1.py); if unset, falls back to OPS_ALARM_WEBHOOK_URL.
# Telegram (TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID): default RED-only pings; set yellow to also ping YELLOW. GREEN is webhook-only.
# CROSS_LENS_RAG_ALERT_WEBHOOK_URL=
# CROSS_LENS_RAG_ALERT_TELEGRAM_NOTIFY=0
# CROSS_LENS_RAG_ALERT_TELEGRAM_MIN_STATUS=red
# Athena ECC audit (athena_run_v1): optional POST after each append-only audit row — minimal JSON (no secrets). Non-fatal if POST fails.
# ATHENA_ECC_AUDIT_WEBHOOK_URL=
# Optional: Macro Risk n8n daily check failure (Run-MacroRiskN8nDailyCheck.ps1); if unset, falls back to OPS_ALARM_WEBHOOK_URL
# MKM_DAILY_CHECK_FAILURE_WEBHOOK_URL=
# Optional: Fragility Y-axis gate alerts (Invoke-FragilityMacroRiskDaily.ps1): RED on each pass when gate=RED; AMBER only on transition into AMBER (not every day while stuck in AMBER). Falls back to OPS_ALARM_WEBHOOK_URL if unset.
# MKM_FRAGILITY_GATE_ALERT_WEBHOOK_URL=
# n8n webhook macro-risk-mail-approval: header x-mkm-approval-token (optional; trigger_macro_risk_mail_approval_webhook.ps1 / Run-MacroRiskN8nOpsQuick.ps1)
# MKM_MACRO_RISK_APPROVAL_TOKEN=
# VIP_DISPATCH_WEBHOOK_URL=
# Compression KPI / SLA band alarms (optional webhook): send_compression_kpi_alarm_if_needed.ps1 prefers
# COMPRESSION_KPI_ALARM_WEBHOOK_URL, then falls back to OPS_ALARM_WEBHOOK_URL. If both unset, alarms are skipped (stdout only).
# Thresholds SSOT: docs/final/artifacts/compression_alarm_thresholds_v1.json — see P0_COMMERCIALIZATION_TRACKER.md compression KPI row.
# COMPRESSION_KPI_ALARM_WEBHOOK_URL=
# Optional next: VPS same-host L1 bench — docs/final/BENCH_L1_API_LOAD_VPS_RUNBOOK.md (BASE_URL on host; summary artifact bench_l1_api_load_summary_vps_latest.json).
# no1kmedi PIN lookup abuse alert webhook
# PIN_LOOKUP_ALERT_WEBHOOK_URL=
# Token compression API stubs (v1/v2): CORS for browser Explorer / file://. Default * if unset.
# COMPRESSION_API_CORS_ALLOW_ORIGINS=*
# Secure envelope key provider mode for /v1/research/l1_side_channel/wire/secure
# MKM_ENVELOPE_KEY_PROVIDER=external_kms
# MKM_ENVELOPE_A_TRACK_KEY_ID=kms/a-track/primary
# MKM_ENVELOPE_B_TRACK_KEY_ID=kms/b-track/primary
# External key resolver contract:
# 1) command hook (recommended): returns one base64 key for MKM_ENVELOPE_KEY_TRACK
# MKM_ENVELOPE_EXTERNAL_KEY_CMD=py scripts/fetch_secure_envelope_key_adapter.py
# optional track-specific upstream commands used by adapter:
# MKM_ENVELOPE_EXTERNAL_KEY_CMD_A_TRACK=
# MKM_ENVELOPE_EXTERNAL_KEY_CMD_B_TRACK=
# 2) or JSON map fallback:
# MKM_ENVELOPE_EXTERNAL_KEY_FILE=C:/secure/keys/secure_envelope_key_map.json
# Local env-key mode (non-external_kms) fallback:
# MKM_ENVELOPE_A_TRACK_KEY_B64=
# MKM_ENVELOPE_B_TRACK_KEY_B64=

