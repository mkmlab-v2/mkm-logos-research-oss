{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/.pytest_cache/**": true,
    "**/.venv/**": true,
    "**/.venv-*/**": true,
    "**/.venv_*/**": true,
    "**/site-packages/**": true,
    "**/dist/**": true,
    "logs/**": true,
    "reports/**": true,
    "storage/**": true,
    "_tmp_mkmlife_deploy/**": true,
    "_pr_sasang_promotion/**": true,
    "docs/final/artifacts/**": true
  },
  "search.exclude": {
    "docs/final/artifacts/**": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/.venv-*": true,
    "**/.venv_*": true,
    "logs": true,
    "reports": true,
    "storage": true,
    "_tmp_mkmlife_deploy": true,
    "_pr_sasang_promotion": true
  },
  "python.analysis.exclude": [
    "logs",
    "reports",
    "storage",
    "vendor",
    ".vendor",
    "_tmp_mkmlife_deploy",
    "_pr_sasang_promotion",
    "projects/mkm",
    "projects/no1kmedi",
    "**/.venv",
    "**/.venv-*",
    "**/.venv_*",
    "**/site-packages"
  ],
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.hideOnStartup": "always",
  "terminal.integrated.focusAfterRun": "never",
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.hideOnLastClosed": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "workbench.reduceMotion": "on",
  "task.autoDetect": "off",
  "npm.autoDetect": "off",
  "typescript.tsc.autoDetect": "off",
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "jema12.autoStartServers": false
}
