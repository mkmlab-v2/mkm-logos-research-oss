{
  "schema": "night_watchman_harness_config_v1",
  "history_root": "docs/final/artifacts/night_watchman_harness/history",
  "lock_file": "docs/final/artifacts/night_watchman_harness_lock_latest.json",
  "status_log_file": "docs/final/artifacts/night_watchman_harness_log.jsonl",
  "alerts": {
    "enabled": true,
    "webhook_env_var": "FACT_SAFE_SLACK_WEBHOOK_URL",
    "headline": ":rotating_light: [Night Watchman Harness] POLICY VIOLATION (HOLD)"
  },
  "rollback_targets": [
    "docs/final/artifacts/prophecy_2026_monthly_kospi_btc_fact_safe_v1.json",
    "docs/final/artifacts/high_reliability_mode_gate_latest.json",
    "projects/bitcoin-trading/memory/v2/risk/risk_profile_fact_safe_latest.json"
