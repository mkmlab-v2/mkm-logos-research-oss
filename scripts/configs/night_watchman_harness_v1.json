          "PASS"
        ]
      },
      {
        "name": "btrack_promotion_gate_pass",
        "file": "reports/constitution/btrack_pilot/btrack_promotion_gate_anchor_verified_only_latest.json",
        "json_path": "decision",
        "allowed_values": [
          "pass"
        ]
      }
    ],
    "lock_contract": {
      "name": "prophecy_low_or_hold_requires_lock",
      "file": "docs/final/artifacts/prophecy_2026_monthly_kospi_btc_fact_safe_v1.json",
      "badge_path": "meta.reliability_badge",
      "decision_path": "meta.high_reliability_decision",
      "locked_path": "meta.price_output_locked"
    },
    "numeric_drift": [
      {
        "name": "risk_fused_pressure_stability",
        "file": "docs/final/artifacts/prophecy_2026_monthly_kospi_btc_fact_safe_v1.json",
        "json_path": "risk_profile.fused_risk_pressure",
        "max_abs_delta": 0.2
      },
      {
        "name": "risk_position_scale_cap_stability",
        "file": "docs/final/artifacts/prophecy_2026_monthly_kospi_btc_fact_safe_v1.json",
        "json_path": "risk_profile.position_scale_cap",
        "max_abs_delta": 0.5
      },
      {
        "name": "risk_daily_loss_cap_stability",
        "file": "docs/final/artifacts/prophecy_2026_monthly_kospi_btc_fact_safe_v1.json",
        "json_path": "risk_profile.daily_loss_cap_pct",
        "max_abs_delta": 0.5
      },
      {
        "name": "meta_net_delta_7d_stability",
        "file": "docs/final/artifacts/prophecy_2026_monthly_kospi_btc_fact_safe_v1.json",
        "json_path": "meta.net_delta_7d",
        "max_abs_delta": 2.0
      }
    ]
  }
}
