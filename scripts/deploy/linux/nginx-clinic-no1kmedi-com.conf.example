# clinic.no1kmedi.com → no1kmedi Next (3010), middleware → /clinician
# Install: scripts/deploy/linux/apply_clinic_no1kmedi_nginx_v1.sh

server {
    listen 80;
    listen [::]:80;
    server_name clinic.no1kmedi.com www.clinic.no1kmedi.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name clinic.no1kmedi.com www.clinic.no1kmedi.com;

    ssl_certificate     /etc/letsencrypt/live/clinic.no1kmedi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clinic.no1kmedi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
