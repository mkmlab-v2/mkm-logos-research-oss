# MKM monorepo VPS — environment file template (comments / placeholders only).
#
# DO NOT commit a filled copy. On the server:
#   sudo install -m 600 -o root -g root mkm-monorepo-vps.env /etc/mkm/mkm-monorepo.env
# Wire into systemd or PM2 ecosystem env per host runbook.
#
# Key names should match repo root `.env.example`. Values live only on the host.

# --- Trading / exchange (example) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# --- Live flags (example; align with trading_config + runbook) ---
# TESTNET=1
# ENABLE_TRADING=0

# --- Optional workspace override on VPS ---
# MKM_WORKSPACE_ROOT=/opt/your-monorepo-clone
