# jema-ai.com apex → app.jema-ai.com (301), except /smartfarm → farm.jema-ai.com (308 B2B canonical).
# Install: scripts/deploy/linux/apply_jema_ai_com_apex_nginx_v1.sh

server {
    listen 80;
    listen [::]:80;
    server_name jema-ai.com www.jema-ai.com;

    location = /smartfarm {
        return 308 https://farm.jema-ai.com/;
    }
    location ^~ /smartfarm/ {
        rewrite ^/smartfarm/(.*)$ https://farm.jema-ai.com/$1 permanent;
    }

    return 301 https://app.jema-ai.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jema-ai.com www.jema-ai.com;

    ssl_certificate /etc/letsencrypt/live/jema-ai.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jema-ai.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /smartfarm {
        return 308 https://farm.jema-ai.com/;
    }
    location ^~ /smartfarm/ {
        rewrite ^/smartfarm/(.*)$ https://farm.jema-ai.com/$1 permanent;
    }

    return 301 https://app.jema-ai.com$request_uri;
}
