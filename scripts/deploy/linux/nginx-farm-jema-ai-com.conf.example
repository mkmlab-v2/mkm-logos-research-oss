# farm.jema-ai.com → no1kmedi Next (port 3010), same upstream as app.jema-ai.com
# Install: copy to /etc/nginx/sites-available/farm.jema-ai.com
#          ln -s ... sites-enabled/ ... && nginx -t && systemctl reload nginx
# DNS: farm CNAME or A → same VPS as app.jema-ai.com (Cloudflare proxied OK)

server {
    listen 80;
    listen [::]:80;
    server_name farm.jema-ai.com;
    return 301 https://farm.jema-ai.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name farm.jema-ai.com;

    # TLS: reuse app.jema-ai.com cert paths or certbot -d farm.jema-ai.com
    ssl_certificate     /etc/letsencrypt/live/farm.jema-ai.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farm.jema-ai.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Optional: add DNS for www.farm.jema-ai.com then duplicate cert + server block.
