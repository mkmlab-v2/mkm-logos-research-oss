# research.no1kmedi.com — MKM LAB static (same docroot as legacy mkmlab.space)
# Install: scripts/deploy/linux/apply_research_no1kmedi_nginx_v1.sh
# DNS: scripts/ensure_no1kmedi_research_clinic_cloudflare_dns_v1.py

server {
    listen 80;
    listen [::]:80;
    server_name research.no1kmedi.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name research.no1kmedi.com;

    ssl_certificate     /etc/letsencrypt/live/research.no1kmedi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/research.no1kmedi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/mkmlab;
    index index.html en.html;

    location / {
        try_files $uri $uri/ =404;
    }
}
