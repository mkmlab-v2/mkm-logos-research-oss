# no1kmedi.com apex — 대국민 한의학 Q&A (Next :3010, middleware → /ask)
# api.no1kmedi.com remains separate vhost. Install: apply_no1kmedi_com_portal_nginx_v1.sh

server {
    listen 80;
    listen [::]:80;
    server_name no1kmedi.com www.no1kmedi.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name no1kmedi.com www.no1kmedi.com;

    ssl_certificate     /etc/letsencrypt/live/no1kmedi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/no1kmedi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
