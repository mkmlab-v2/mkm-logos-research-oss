# logos.jema-ai.com → no1kmedi Next (port 3010), same upstream as app.jema-ai.com
# Install: scripts/deploy/linux/apply_logos_jema_ai_nginx_v1.sh
# DNS: logos CNAME → app.jema-ai.com (Cloudflare proxied OK)

server {
    listen 80;
    listen [::]:80;
    server_name logos.jema-ai.com www.logos.jema-ai.com;
    return 301 https://logos.jema-ai.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name logos.jema-ai.com;

    # Wildcard *.jema-ai.com (same as farm.jema-ai.com pattern)
    ssl_certificate     /etc/letsencrypt/live/jema-ai.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jema-ai.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.logos.jema-ai.com;
    return 301 https://logos.jema-ai.com$request_uri;
}
