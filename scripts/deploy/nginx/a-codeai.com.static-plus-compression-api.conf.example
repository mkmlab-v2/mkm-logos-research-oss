# a-codeai.com — static landing + MKM compression API stub (8010) on same host
# SSH 관측(2026): / 는 8010 전부 프록시라 GET / 가 API 404 JSON. /var/www/a-codeai.com 에 정적이 있으면 아래처럼 분리.
#
# 적용 순서 (권장):
#  1) sudo cp /etc/nginx/sites-enabled/a-codeai.com /etc/nginx/sites-enabled/a-codeai.com.bak
#  2) 기존 server { listen 443 ... } 블록의 location / 프록시를 아래 패턴으로 교체(ssl·server_name·cert 유지)
#  3) sudo nginx -t && sudo systemctl reload nginx
#  4) curl -sSI https://a-codeai.com/ → text/html; curl -sS https://a-codeai.com/health → JSON ok
#
# 주의: Let’s Encrypt /.well-known 은 기존 certbot root 블록 유지.

server {
    listen 443 ssl http2;
    server_name a-codeai.com www.a-codeai.com;

    # ssl_certificate / ssl_certificate_key — 기존 letsencrypt 경로 유지

    # Compression token API stub (FastAPI): /health, /v1/*
    location = /health {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public site (SPA or static): adjust root to match server path
    location / {
        root /var/www/a-codeai.com;
        try_files $uri $uri/ /index.html;
    }
}

# HTTP → HTTPS: 기존 server { listen 80; ... return 301 https://... } 유지
