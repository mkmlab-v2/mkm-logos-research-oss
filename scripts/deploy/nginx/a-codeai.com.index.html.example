<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>A-CODEAI | 토큰 압축 Open Bench (Controlled Beta)</title>
  <meta
    name="description"
    content="재현 가능한 벤치마크 기반 B2B 토큰 압축 오픈벤치. 대기명단 우선 Controlled beta · SEND_GATE=HOLD."
  />
  <link rel="canonical" href="https://a-codeai.com/ko/" />
  <link rel="alternate" hreflang="en" href="https://a-codeai.com/" />
  <link rel="alternate" hreflang="ko" href="https://a-codeai.com/ko/" />
  <link rel="alternate" hreflang="x-default" href="https://a-codeai.com/" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:locale:alternate" content="en_US" />
  <style>
    :root {
      --bg: #070e1f;
      --bg-soft: #0f1a33;
      --panel: #121f3d;
      --text: #edf2ff;
      --muted: #a7b6d8;
      --line: #263a66;
      --line-strong: #38518a;
      --primary: #86abff;
      --primary-dark: #0a1738;
      --ok: #7ef0c2;
      --warn: #ffd27a;
      --card-shadow: 0 10px 30px rgba(6, 13, 28, 0.35);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", "Noto Sans KR", Arial, sans-serif;
      background: radial-gradient(1200px 500px at 80% -10%, #173063 0%, transparent 60%), linear-gradient(180deg, var(--bg), #0b1733 55%, #0d1c3f);
      color: var(--text);
      line-height: 1.55;
    }
    a { color: inherit; }
    .skip-link {
      position: absolute;
      left: -9999px;
      top: auto;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }
    .skip-link:focus-visible {
      left: 12px;
      top: 12px;
      z-index: 50;
      width: auto;
      height: auto;
      padding: 8px 12px;
      border-radius: 8px;
      background: var(--primary);
      color: var(--primary-dark);
      font-weight: 700;
      text-decoration: none;
    }
    .container {
      width: min(1080px, 92vw);
      margin: 0 auto;
    }
    .topbar {
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(8px);
      background: color-mix(in oklab, #071024 84%, transparent);
    }
    .topbar-inner {
      min-height: 58px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-weight: 700; letter-spacing: 0.02em; }
    .lang { color: var(--muted); font-size: 13px; }
    .lang a { color: var(--text); }
    .hero {
      padding: 72px 0 44px;
      border-bottom: 1px solid var(--line);
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 14px;
      align-items: stretch;
    }
    .hero-main,
    .hero-side {
      border: 1px solid var(--line);
      border-radius: 16px;
      background: color-mix(in oklab, var(--panel), black 10%);
      box-shadow: var(--card-shadow);
      padding: 18px;
    }
    .hero-side .label { margin-top: 0; }
    .hero-side ul { margin-top: 8px; }
    .badge-row { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
    .badge {
      font-size:12px;
      padding:4px 10px;
      border:1px solid var(--line);
      border-radius:999px;
      color:var(--muted);
      background: color-mix(in oklab, var(--panel), black 8%);
    }
    h1 {
      font-size: clamp(32px, 4.6vw, 56px);
      line-height: 1.06;
      margin: 0 0 16px;
      letter-spacing: -0.02em;
    }
    .subtitle {
      color: var(--muted);
      max-width: 760px;
      font-size: 19px;
      margin: 0 0 26px;
    }
    .cta-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-block;
      padding: 12px 18px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid transparent;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      padding: 0 16px;
    }
    .btn-primary {
      background: var(--primary);
      color: var(--primary-dark);
      box-shadow: 0 10px 28px rgba(122, 162, 255, 0.25);
    }
    .btn-ghost {
      border-color: var(--line);
      background: color-mix(in oklab, var(--panel), black 6%);
    }
    .btn-ghost:hover {
      border-color: var(--line-strong);
      text-decoration: none;
    }
    section { padding: 44px 0; border-bottom: 1px solid var(--line); }
    h2 { margin: 0 0 12px; font-size: 28px; letter-spacing: -0.01em; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
    }
    .card {
      background: color-mix(in oklab, var(--panel), black 8%);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px;
      box-shadow: var(--card-shadow);
    }
    .label {
      font-size: 12px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
    }
    .kpi { font-size: 30px; font-weight: 800; margin: 0; }
    .small { color: var(--muted); margin: 0; }
    .mono { font-family: Consolas, Menlo, monospace; font-size: 13px; color: #d7e2ff; margin: 0; }
    ul { margin: 0; padding-left: 18px; color: var(--muted); }
    .trust-list { display:grid; gap:10px; margin:14px 0 0; }
    .trust-item {
      border:1px dashed var(--line);
      border-radius:12px;
      padding:12px;
      background: color-mix(in oklab, var(--bg-soft), black 2%);
      color:var(--muted);
    }
    .legal {
      border: 1px solid var(--line);
      background: color-mix(in oklab, var(--bg-soft), black 4%);
      padding: 18px;
      border-radius: 14px;
      color: var(--muted);
    }
    .pill { display:inline-block; padding:2px 8px; border-radius:999px; font-size:12px; font-weight:700; margin-right:6px; }
    .pill-ok { color:#102317; background: var(--ok); }
    .pill-warn { color:#2a1e00; background: var(--warn); }
    .final-cta {
      border:1px solid var(--line);
      border-radius:14px;
      padding:20px;
      display:flex;
      flex-wrap:wrap;
      justify-content:space-between;
      gap:14px;
      align-items:center;
      background: color-mix(in oklab, var(--panel), black 8%);
    }
    footer { padding: 28px 0 40px; color: var(--muted); font-size: 13px; }
    .footer-meta { margin: 0 0 8px; line-height: 1.6; }
    .footer-meta a { color: #c5d8ff; }
    .footer-links { margin: 8px 0 0; }
    .ecosystem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .ecosystem-item {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: color-mix(in oklab, var(--bg-soft), black 3%);
      padding: 14px;
    }
    .ecosystem-item a {
      color: #d5e3ff;
      font-weight: 700;
    }
    .ecosystem-item p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
    }
    .focus-link:focus-visible,
    .btn:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .card,
      .trust-item,
      .ecosystem-item {
        transition: transform 0.2s ease, border-color 0.2s ease;
      }
      .card:hover,
      .trust-item:hover,
      .ecosystem-item:hover {
        transform: translateY(-2px);
        border-color: var(--line-strong);
      }
    }
    @media (max-width: 840px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">본문으로 건너뛰기</a>
  <nav class="topbar" aria-label="Top navigation">
    <div class="container topbar-inner">
      <div class="brand">A-CODEAI</div>
      <div class="lang">Language: <a class="focus-link" href="/">EN</a> | <strong>KO</strong></div>
    </div>
  </nav>

  <header class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-main">
          <div class="badge-row">
            <span class="badge">B2B 압축 API</span>
            <span class="badge">Fact-Lock 근거</span>
            <span class="badge">SEND_GATE HOLD</span>
          </div>
          <h1 id="pg-hero-title">A-CODEAI Open Bench (Controlled Beta + 대기명단)</h1>
          <p class="subtitle" id="pg-hero-subtitle">
            측정된 압축 성능은 재현 가능한 근거와 함께 공개하며, SEND_GATE는 HOLD를 유지하고 온보딩은 대기명단 우선으로 운영합니다.
          </p>
          <p class="small" id="pg-status-line">상태: Controlled beta waitlist · SEND_GATE=HOLD</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#contact">대기명단 신청</a>
            <a class="btn btn-ghost" href="/benchmark">벤치마크 정책</a>
            <a class="btn btn-ghost" href="https://github.com/mkmlab-v2/a-codeai-compression-reproduce" target="_blank" rel="noopener noreferrer">GitHub 재현</a>
          </div>
        </div>
        <aside class="hero-side" aria-label="신뢰 스냅샷">
          <p class="label">신뢰 스냅샷</p>
          <p class="small">Track A active와 contributor 레인은 정책상 분리 보고됩니다.</p>
          <ul>
            <li id="pg-trust-lane-1">Track A active: 토큰 절감 47.54%, 최소 jaccard 0.714 (분리 레인)</li>
            <li id="pg-trust-lane-2">Contributor 레인: 절감 25.1%, raw alignment pass 63.3% (19/30)</li>
            <li id="pg-trust-lane-3">SEND_GATE HOLD와 waitlist-first 온보딩 유지</li>
          </ul>
        </aside>
      </div>
    </div>
  </header>

  <main id="main-content">
  <section id="fit">
    <div class="container">
      <h2>누가 쓰면 효과가 큰가</h2>
      <div class="grid">
        <article class="card"><p class="label">플랫폼 팀</p><p class="small">LLM 토큰 비용을 측정 가능한 압축 프로파일로 줄이려는 API·플랫폼 조직</p></article>
        <article class="card"><p class="label">평가 범위</p><p class="small">오픈벤치 재현·헬스체크·범위 한정 파일럿 준비 — 전역 SLA 주장 아님</p></article>
        <article class="card"><p class="label">온보딩</p><p class="small">모니터링·가드레일 수락 기반 waitlist-first controlled beta</p></article>
      </div>
    </div>
  </section>

  <section id="trust">
    <div class="container">
      <h2>왜 평가하는가</h2>
      <div class="trust-list">
        <div class="trust-item"><span class="pill pill-ok">재현 우선</span> 주장은 명령·아티팩트·CI 검증과 함께 공개됩니다.</div>
        <div class="trust-item"><span class="pill pill-ok">레인 분리</span> Track A active와 contributor open-bench 지표를 합치지 않습니다.</div>
        <div class="trust-item"><span class="pill pill-ok">안전 폴백</span> readiness/health 미충족 시 HOLD/track_a_primary로 강등됩니다.</div>
        <div class="trust-item"><span class="pill pill-warn">SEND HOLD</span> counsel·실고객 측정 게이트 전까지 대량 마케팅 없음.</div>
      </div>
    </div>
  </section>

  <section id="flow">
    <div class="container">
      <h2>Controlled beta 진행 방식</h2>
      <div class="grid">
        <article class="card"><p class="label">1단계</p><p class="small">공개 재현 명령 실행 및 /health·API 라우트 동작 확인</p></article>
        <article class="card"><p class="label">2단계</p><p class="small">벤치 정책 검토 — Track A·contributor 레인 분리 보고</p></article>
        <article class="card"><p class="label">3단계</p><p class="small">내부 수락 검토 후 범위 한정 B2B 파일럿 대기명단 신청</p></article>
      </div>
    </div>
  </section>

  <section id="pilot">
    <div class="container">
      <h2>파일럿·상업 조건</h2>
      <p class="small">가격·90일 파일럿 조항은 파일럿 페이지에 정리되어 있습니다. SEND_GATE HOLD 동안 홈은 오픈벤치 평가와 대기명단 온보딩에 집중합니다.</p>
      <div class="cta-row" style="margin-top:14px">
        <a class="btn btn-ghost" href="/pilot">파일럿 상세 보기</a>
      </div>
    </div>
  </section>

  <section id="benchmark">
    <div class="container">
      <h2>증거 공개 및 검증 원칙</h2>
      <div class="grid">
        <article class="card"><p class="label">투명성</p><p class="small">맞은/틀린 사례를 월 단위로 함께 공개</p></article>
        <article class="card"><p class="label">재현성</p><p class="small">명령과 아티팩트 경로를 감사 가능하게 공개</p></article>
        <article class="card"><p class="label">한계 고지</p><p class="small">오탐/미탐 가능성을 선고지</p></article>
      </div>
      <div class="trust-list" style="margin-top:14px">
        <div class="trust-item" id="pg-claim-1"><span class="pill pill-ok">Fact-Lock</span><span id="pg-claim-1-text"> 조건이 검증된 구간에서만 개선 수치를 주장합니다.</span></div>
        <div class="trust-item" id="pg-claim-2"><span class="pill pill-ok">안전 폴백</span><span id="pg-claim-2-text"> readiness/health가 미충족이면 HOLD/track_a_primary로 자동 강등됩니다.</span></div>
        <div class="trust-item" id="pg-claim-3"><span class="pill pill-ok">Waitlist 우선</span><span id="pg-claim-3-text"> Controlled beta는 모니터링 수락된 B2B 파일럿 대기명단으로만 온보딩합니다.</span></div>
        <div class="trust-item" id="pg-non-claim-1"><span class="pill pill-warn">헤드라인 분리</span><span id="pg-non-claim-1-text"> Track A active 지표와 contributor open-bench 지표를 하나의 성과 문구로 합치지 않습니다.</span></div>
      </div>
    </div>
  </section>

  <section id="self-check">
    <div class="container">
      <h2>60초 직접 검증</h2>
      <div class="grid">
        <article class="card">
          <p class="label">Step 1</p>
          <p class="small">홈페이지가 HTML로 정상 응답하는지 확인</p>
          <p class="mono">curl -sSI https://a-codeai.com/</p>
        </article>
        <article class="card">
          <p class="label">Step 2</p>
          <p class="small">헬스체크 JSON 상태 확인</p>
          <p class="mono">curl -sS https://a-codeai.com/health</p>
        </article>
        <article class="card">
          <p class="label">Step 3</p>
          <p class="small">API 라우트 동작 확인</p>
          <p class="mono">curl -sSI https://a-codeai.com/v1/compress</p>
        </article>
      </div>
    </div>
  </section>

  <section id="trust-ops">
    <div class="container">
      <h2>신뢰를 만드는 운영 원칙</h2>
      <div class="trust-list">
        <div class="trust-item"><span class="pill pill-ok">가짜 사회적 증거 금지</span> 익명 추천사·검증 불가 성장수치 사용 금지.</div>
        <div class="trust-item"><span class="pill pill-ok">재현 우선 업데이트</span> 새로운 성과 주장은 재현 경로와 함께 공개.</div>
        <div class="trust-item"><span class="pill pill-ok">오픈 테스트 절차</span> 파일럿 계약 전에도 라우트/헬스 점검 직접 실행 가능.</div>
        <div class="trust-item"><span class="pill pill-warn">적용 경계 명확화</span> 100% 리터럴 보존 필수 워크로드는 수주를 제한.</div>
      </div>
    </div>
  </section>

  <section id="ecosystem">
    <div class="container">
      <h2>MKM 도메인 연결</h2>
      <p class="small">A-CODEAI는 B2B 압축/검증 표면이며, 나머지 도메인은 역할 분리 정책을 유지합니다.</p>
      <div class="ecosystem-grid">
        <article class="ecosystem-item">
          <a href="https://jema-ai.com/" target="_blank" rel="noopener noreferrer">jema-ai.com</a>
          <p>브랜드/엔터프라이즈 허브. 파트너·제품 진입 분기.</p>
        </article>
        <article class="ecosystem-item">
          <a href="https://mkmlife.com/" target="_blank" rel="noopener noreferrer">mkmlife.com</a>
          <p>소비자 원퀘스천 리포트 및 웰니스 중심 UX.</p>
        </article>
        <article class="ecosystem-item">
          <a href="https://jemaai.cloud/" target="_blank" rel="noopener noreferrer">jemaai.cloud</a>
          <p>비실매매 공개 관측 보드 전용 표면.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <div class="final-cta">
        <div>
          <h2 style="margin-bottom:8px" id="pg-cta-label">Controlled Beta 대기명단 신청</h2>
          <p class="small" id="pg-cta-note">온보딩은 waitlist-first이며, 모니터링·가드레일 수락 및 SEND_GATE HOLD 준수 범위에서만 진행합니다.</p>
        </div>
        <div class="cta-row" style="margin:0">
          <a class="btn btn-primary" id="pg-cta-apply" href="https://app.jema-ai.com/enterprise/apply">Controlled beta 신청</a>
          <a class="btn btn-ghost" href="mailto:contact@a-codeai.com?subject=%5B%ED%9A%8C%EC%82%AC%EB%AA%85%5D%20%EC%95%95%EC%B6%95%20%EC%98%A4%ED%94%88%EB%B2%A4%EC%B9%98%20%EB%8C%80%EA%B8%B0%EB%AA%85%EB%8B%A8">이메일 문의</a>
          <a class="btn btn-ghost" href="/pilot">파일럿 상세</a>
        </div>
      </div>
    </div>
  </section>

  <section id="legal">
    <div class="container legal">
      <strong>법적 고지</strong>
      <p>본 서비스는 B2B 토큰 압축 평가 API 및 오픈벤치 근거를 제공합니다. 투자자문·매매권유가 아니며, 측정 이득은 조건부·레인 분리 기준입니다. 최종 도입 결정 책임은 고객사에 있습니다.</p>
      <p style="margin-top:14px"><strong>운영 주체</strong></p>
      <p class="small" style="margin-top:6px">
        주식회사 목소리네트워크 · 대표 이기륜<br />
        사업자등록번호 628-86-01742<br />
        주소: 경기도 광명시 디지털로 24, 102동 2301호<br />
        문의: <a href="mailto:contact@a-codeai.com">contact@a-codeai.com</a>
      </p>
      <p class="small footer-links">
        <a href="https://jema-ai.com/privacy" target="_blank" rel="noopener noreferrer">개인정보처리방침 (jema-ai.com)</a>
        · <a href="/ko/legal">법적 고지</a>
        · <a href="/pilot">파일럿 안내</a>
        · <a href="/benchmark">검증 정책</a>
      </p>
      <p class="small" style="margin-top:10px">
        대기명단·enterprise apply 경로에서 연락처가 수집될 수 있으며, 처리 기준은 상기 개인정보처리방침을 따릅니다.
        SEND_GATE는 HOLD이며 대량 마케팅은 하지 않습니다.
      </p>
    </div>
  </section>
  </main>

  <footer>
    <div class="container">
      <p class="footer-meta">A-CODEAI · Fact-Lock 운영 원칙의 B2B 토큰 압축 오픈벤치.</p>
      <p class="footer-meta">© 2026 주식회사 목소리네트워크. 무단 복제를 금지합니다.</p>
    </div>
  </footer>
<script>
  (async function () {
    const lang = (document.documentElement.lang || 'en').toLowerCase();
    const isKo = lang.startsWith('ko');
    try {
      const res = await fetch('/a_codeai_public_copy_web_payload_latest.json', { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      const sections = (isKo && data.sections_ko) ? data.sections_ko : (data.sections || {});
      const hero = sections.hero || {};
      const setText = (id, v) => {
        if (!v) return;
        const el = document.getElementById(id);
        if (el) el.textContent = v;
      };
      setText('pg-hero-title', hero.title);
      setText('pg-hero-subtitle', hero.subtitle);
      setText('pg-status-line', hero.status_line);

      const lanes = (data.meta || {}).lane_metrics || {};
      if (lanes.track_a_saving_pct) {
        setText(
          'pg-trust-lane-1',
          isKo
            ? `Track A active: 토큰 절감 ${lanes.track_a_saving_pct}%, 최소 jaccard ${lanes.track_a_min_jaccard} (분리 레인)`
            : `Track A active: ${lanes.track_a_saving_pct}% token saving, min jaccard ${lanes.track_a_min_jaccard} (separate lane)`
        );
      }
      if (lanes.contributor_saving_pct) {
        setText(
          'pg-trust-lane-2',
          isKo
            ? `Contributor 레인: 절감 ${lanes.contributor_saving_pct}%, raw alignment pass ${lanes.contributor_raw_alignment_pct}% (${lanes.contributor_pass_fraction})`
            : `Contributor lane: ${lanes.contributor_saving_pct}% saving, raw alignment pass ${lanes.contributor_raw_alignment_pct}% (${lanes.contributor_pass_fraction})`
        );
      }

      const claims = sections.claims || [];
      const nonClaims = sections.non_claims || [];
      setText('pg-claim-1-text', claims[0] ? ` ${claims[0]}` : null);
      setText('pg-claim-2-text', claims[1] ? ` ${claims[1]}` : null);
      setText('pg-claim-3-text', claims[2] ? ` ${claims[2]}` : null);
      setText('pg-non-claim-1-text', nonClaims[0] ? ` ${nonClaims[0]}` : null);

      const cta = sections.cta || {};
      setText('pg-cta-label', cta.label);
      setText('pg-cta-note', cta.note);
      if (cta.apply_href) {
        const apply = document.getElementById('pg-cta-apply');
        if (apply) apply.href = cta.apply_href;
      }
    } catch (_) {
      // Keep static fallback copy.
    }
  })();
</script>
</body>
</html>
