<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>A-CODEAI | Token Compression Open Bench (Controlled Beta)</title>
  <meta
    name="description"
    content="B2B token compression open bench with reproducible benchmarks. Waitlist-first controlled beta; SEND_GATE=HOLD."
  />
  <link rel="canonical" href="https://a-codeai.com/" />
  <link rel="alternate" hreflang="en" href="https://a-codeai.com/" />
  <link rel="alternate" hreflang="ko" href="https://a-codeai.com/ko/" />
  <link rel="alternate" hreflang="x-default" href="https://a-codeai.com/" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="ko_KR" />
  <style>
    :root {
      --bg: #070e1f;
      --bg-soft: #0f1a33;
      --panel: #121f3d;
      --text: #edf2ff;
      --muted: #a7b6d8;
      --line: #263a66;
      --line-strong: #38518a;
      --primary: #86abff;
      --primary-dark: #0a1738;
      --ok: #7ff0c3;
      --warn: #ffd27a;
      --card-shadow: 0 10px 30px rgba(6, 13, 28, 0.35);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", "Noto Sans", Arial, sans-serif;
      color: var(--text);
      background: radial-gradient(1200px 500px at 85% -10%, #173063 0%, transparent 60%), linear-gradient(180deg, var(--bg), #0b1733 55%, #0d1c3f);
      line-height: 1.55;
    }
    a { color: inherit; }
    .skip-link {
      position: absolute;
      left: -9999px;
      top: auto;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }
    .skip-link:focus-visible {
      left: 12px;
      top: 12px;
      z-index: 50;
      width: auto;
      height: auto;
      padding: 8px 12px;
      border-radius: 8px;
      background: var(--primary);
      color: var(--primary-dark);
      font-weight: 700;
      text-decoration: none;
    }
    .container { width: min(1080px, 92vw); margin: 0 auto; }
    .topbar {
      position: sticky;
      top: 0;
      backdrop-filter: blur(8px);
      background: color-mix(in oklab, #071024 84%, transparent);
      border-bottom: 1px solid var(--line);
      z-index: 10;
    }
    .topbar-inner {
      min-height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .brand { font-weight: 700; letter-spacing: 0.02em; }
    .lang { color: var(--muted); font-size: 13px; }
    .hero { padding: 72px 0 44px; border-bottom: 1px solid var(--line); }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 14px;
      align-items: stretch;
    }
    .hero-main,
    .hero-side {
      border: 1px solid var(--line);
      border-radius: 16px;
      background: color-mix(in oklab, var(--panel), black 10%);
      box-shadow: var(--card-shadow);
      padding: 18px;
    }
    .hero-side .label { margin-top: 0; }
    .hero-side ul { margin-top: 8px; }
    .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }
    .badge {
      font-size: 12px;
      padding: 4px 10px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      background: color-mix(in oklab, var(--panel), black 8%);
    }
    h1 {
      font-size: clamp(32px, 4.6vw, 56px);
      line-height: 1.06;
      letter-spacing: -0.02em;
      margin: 0 0 16px;
      max-width: 820px;
    }
    .subtitle {
      color: var(--muted);
      font-size: 19px;
      max-width: 760px;
      margin: 0 0 26px;
    }
    .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      min-height: 44px;
      padding: 0 16px;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: var(--primary);
      color: var(--primary-dark);
      box-shadow: 0 10px 28px rgba(122, 162, 255, 0.25);
    }
    .btn-secondary {
      border-color: var(--line);
      background: color-mix(in oklab, var(--panel), black 6%);
    }
    .btn-secondary:hover {
      border-color: var(--line-strong);
      text-decoration: none;
    }
    section { padding: 42px 0; border-bottom: 1px solid var(--line); }
    h2 { margin: 0 0 12px; font-size: 28px; letter-spacing: -0.01em; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
    .card {
      border: 1px solid var(--line);
      border-radius: 14px;
      background: color-mix(in oklab, var(--panel), black 8%);
      padding: 16px;
      box-shadow: var(--card-shadow);
    }
    .label {
      margin: 0 0 6px;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      font-size: 12px;
      color: var(--muted);
    }
    .kpi { font-size: 30px; font-weight: 800; margin: 0; }
    .small { color: var(--muted); margin: 0; }
    .mono { font-family: Consolas, Menlo, monospace; font-size: 13px; color: #d7e2ff; margin: 0; }
    ul { margin: 0; padding-left: 18px; color: var(--muted); }
    .trust-list { display: grid; gap: 10px; margin: 14px 0 0; }
    .trust-item {
      border: 1px dashed var(--line);
      border-radius: 12px;
      padding: 12px;
      background: color-mix(in oklab, var(--bg-soft), black 2%);
      color: var(--muted);
    }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; margin-right: 6px; }
    .pill-ok { background: var(--ok); color: #102317; }
    .pill-warn { background: var(--warn); color: #2a1e00; }
    .legal {
      border: 1px solid var(--line);
      background: color-mix(in oklab, var(--bg-soft), black 4%);
      border-radius: 14px;
      padding: 18px;
      color: var(--muted);
    }
    .final-cta {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 14px;
      align-items: center;
      background: color-mix(in oklab, var(--panel), black 8%);
    }
    footer { padding: 24px 0 36px; color: var(--muted); font-size: 13px; }
    .footer-meta { margin: 0 0 8px; line-height: 1.6; }
    .footer-meta a { color: #c5d8ff; }
    .footer-links { margin: 8px 0 0; }
    .ecosystem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .ecosystem-item {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: color-mix(in oklab, var(--bg-soft), black 3%);
      padding: 14px;
    }
    .ecosystem-item a {
      color: #d5e3ff;
      font-weight: 700;
    }
    .ecosystem-item p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
    }
    .focus-link:focus-visible,
    .btn:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .card,
      .trust-item,
      .ecosystem-item {
        transition: transform 0.2s ease, border-color 0.2s ease;
      }
      .card:hover,
      .trust-item:hover,
      .ecosystem-item:hover {
        transform: translateY(-2px);
        border-color: var(--line-strong);
      }
    }
    @media (max-width: 840px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <nav class="topbar" aria-label="Top navigation">
    <div class="container topbar-inner">
      <div class="brand">A-CODEAI</div>
      <div class="lang">Language: <strong>EN</strong> | <a class="focus-link" href="/ko/">KO</a></div>
    </div>
  </nav>

  <header class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-main">
          <div class="badge-row">
            <span class="badge">B2B Compression API</span>
            <span class="badge">Fact-Lock Evidence</span>
            <span class="badge">SEND_GATE HOLD</span>
          </div>
          <h1 id="pg-hero-title">A-CODEAI Open Bench (Controlled Beta + Waitlist)</h1>
          <p class="subtitle" id="pg-hero-subtitle">
            Measured compression gains are published with reproducible evidence, while SEND_GATE remains HOLD and onboarding stays waitlist-first.
          </p>
          <p class="small" id="pg-status-line">Current status: controlled beta waitlist; SEND_GATE=HOLD.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#contact">Join waitlist</a>
            <a class="btn btn-secondary" href="/benchmark">Benchmark policy</a>
            <a class="btn btn-secondary" href="https://github.com/mkmlab-v2/a-codeai-compression-reproduce" target="_blank" rel="noopener noreferrer">Reproduce on GitHub</a>
          </div>
        </div>
        <aside class="hero-side" aria-label="Trust snapshot">
          <p class="label">Trust Snapshot</p>
          <p class="small">Track A active benchmark and contributor lane are separated by policy and reporting.</p>
          <ul>
            <li id="pg-trust-lane-1">Track A active: 47.54% token saving, min jaccard 0.714 (separate lane)</li>
            <li id="pg-trust-lane-2">Contributor lane: 25.1% saving, raw alignment pass 63.3% (19/30)</li>
            <li id="pg-trust-lane-3">SEND_GATE HOLD and waitlist-first onboarding remain enforced</li>
          </ul>
        </aside>
      </div>
    </div>
  </header>

  <main id="main-content">
    <section id="fit">
      <div class="container">
        <h2>Who this is for</h2>
        <div class="grid">
          <article class="card">
            <p class="label">Platform Teams</p>
            <p class="small">API/platform owners reducing LLM token cost with measurable compression profiles.</p>
          </article>
          <article class="card">
            <p class="label">Evaluation Scope</p>
            <p class="small">Open-bench reproduction, health checks, and scoped pilot readiness — not a global SLA claim.</p>
          </article>
          <article class="card">
            <p class="label">Onboarding</p>
            <p class="small">Waitlist-first controlled beta with monitoring acceptance and guardrail compliance.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="flow">
      <div class="container">
        <h2>How controlled beta works</h2>
        <div class="grid">
          <article class="card">
            <p class="label">Step 1</p>
            <p class="small">Run public reproduce commands and verify /health plus API route behavior.</p>
          </article>
          <article class="card">
            <p class="label">Step 2</p>
            <p class="small">Review benchmark policy with Track A and contributor lanes reported separately.</p>
          </article>
          <article class="card">
            <p class="label">Step 3</p>
            <p class="small">Join the waitlist for a scoped B2B pilot after internal acceptance checks.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="trust">
      <div class="container">
        <h2>Why teams evaluate this</h2>
        <div class="trust-list">
          <div class="trust-item"><span class="pill pill-ok">Repro-First</span> Claims ship with commands, artifacts, and CI-backed checks.</div>
          <div class="trust-item"><span class="pill pill-ok">Lane Separation</span> Track A active metrics never merge with contributor open-bench metrics.</div>
          <div class="trust-item"><span class="pill pill-ok">Safety Fallback</span> HOLD/track_a_primary when readiness or health checks fail.</div>
          <div class="trust-item"><span class="pill pill-warn">SEND HOLD</span> No broad outbound marketing until counsel and customer measurement gates clear.</div>
        </div>
      </div>
    </section>

    <section id="pilot">
      <div class="container">
        <h2>Pilot and commercial terms</h2>
        <p class="small">Commercial pricing and 90-day pilot clauses are documented on the pilot page. Homepage stays on open-bench evaluation and waitlist onboarding while SEND_GATE remains HOLD.</p>
        <div class="cta-row" style="margin-top:14px">
          <a class="btn btn-secondary" href="/pilot">View pilot details</a>
        </div>
      </div>
    </section>

    <section id="benchmark">
      <div class="container">
        <h2>Evidence and verification policy</h2>
        <div class="grid">
          <article class="card">
            <p class="label">Transparency</p>
            <p class="small">Wins and misses are reported together every month.</p>
          </article>
          <article class="card">
            <p class="label">Reproducibility</p>
            <p class="small">Repro commands and evidence paths are disclosed for audit.</p>
          </article>
          <article class="card">
            <p class="label">Limits</p>
            <p class="small">False positives/misses can occur; uncertainty is disclosed upfront.</p>
          </article>
        </div>
        <div class="trust-list" style="margin-top:14px">
          <div class="trust-item" id="pg-claim-1"><span class="pill pill-ok">Fact-Lock</span><span id="pg-claim-1-text"> Conditional improvements are claimed only inside validated operating zones.</span></div>
          <div class="trust-item" id="pg-claim-2"><span class="pill pill-ok">Safety Fallback</span><span id="pg-claim-2-text"> Traffic is downgraded to HOLD/track_a_primary whenever readiness or health checks fail.</span></div>
          <div class="trust-item" id="pg-claim-3"><span class="pill pill-ok">Waitlist First</span><span id="pg-claim-3-text"> Controlled beta onboarding is limited to scoped B2B pilots with monitoring acceptance.</span></div>
          <div class="trust-item" id="pg-non-claim-1"><span class="pill pill-warn">No Mixed Headline</span><span id="pg-non-claim-1-text"> Track A active metrics and contributor open-bench metrics are never merged into one claim.</span></div>
        </div>
      </div>
    </section>

    <section id="self-check">
      <div class="container">
        <h2>Self-check in under 60 seconds</h2>
        <div class="grid">
          <article class="card">
            <p class="label">Step 1</p>
            <p class="small">Verify homepage serves HTML.</p>
            <p class="mono">curl -sSI https://a-codeai.com/</p>
          </article>
          <article class="card">
            <p class="label">Step 2</p>
            <p class="small">Verify health endpoint returns JSON OK.</p>
            <p class="mono">curl -sS https://a-codeai.com/health</p>
          </article>
          <article class="card">
            <p class="label">Step 3</p>
            <p class="small">Verify API route behavior.</p>
            <p class="mono">curl -sSI https://a-codeai.com/v1/compress</p>
          </article>
        </div>
      </div>
    </section>

    <section id="trust-ops">
      <div class="container">
        <h2>Trust by operating discipline</h2>
        <div class="trust-list">
          <div class="trust-item"><span class="pill pill-ok">No fake social proof</span> No anonymous testimonials, no unverifiable growth claims.</div>
          <div class="trust-item"><span class="pill pill-ok">Repro-first updates</span> New claims are published only with reproducible evidence paths.</div>
          <div class="trust-item"><span class="pill pill-ok">Open test workflow</span> Prospects can run route and health checks before pilot contract.</div>
          <div class="trust-item"><span class="pill pill-warn">Scope honesty</span> We reject workloads that require strict 100% literal preservation.</div>
        </div>
      </div>
    </section>

    <section id="ecosystem">
      <div class="container">
        <h2>MKM ecosystem connection</h2>
        <p class="small">A-CODEAI is the B2B compression and verification surface. Other domains stay role-separated by policy.</p>
        <div class="ecosystem-grid">
          <article class="ecosystem-item">
            <a href="https://jema-ai.com/" target="_blank" rel="noopener noreferrer">jema-ai.com</a>
            <p>Brand and enterprise hub for partner entry and product routing.</p>
          </article>
          <article class="ecosystem-item">
            <a href="https://mkmlife.com/" target="_blank" rel="noopener noreferrer">mkmlife.com</a>
            <p>Consumer one-question report funnel and wellness-oriented UX.</p>
          </article>
          <article class="ecosystem-item">
            <a href="https://jemaai.cloud/" target="_blank" rel="noopener noreferrer">jemaai.cloud</a>
            <p>Public observation board only, non-trading and non-advisory surface.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <div class="final-cta">
          <div>
            <h2 style="margin-bottom:8px" id="pg-cta-label">Join Waitlist for Controlled Beta</h2>
            <p class="small" id="pg-cta-note">Pilot onboarding is waitlist-first and limited to scoped B2B workloads with monitoring, guardrail acceptance, and SEND_GATE HOLD compliance.</p>
          </div>
          <div class="cta-row" style="margin:0">
            <a class="btn btn-primary" id="pg-cta-apply" href="https://app.jema-ai.com/enterprise/apply">Apply for controlled beta</a>
            <a class="btn btn-secondary" href="mailto:contact@a-codeai.com?subject=%5BCompany%5D%20compression%20open%20bench%20waitlist">Email us</a>
            <a class="btn btn-secondary" href="/pilot">Pilot details</a>
          </div>
        </div>
      </div>
    </section>

    <section id="legal">
      <div class="container legal">
        <strong>Legal notice</strong>
        <p>
          A-CODEAI provides B2B token compression evaluation APIs and open-bench evidence.
          It is not investment advisory, portfolio management, or trade recommendation.
          Measured gains are conditional and lane-separated; final adoption decisions remain with the client.
        </p>
        <p style="margin-top:14px"><strong>Operator</strong></p>
        <p class="small" style="margin-top:6px">
          Moksori Network Co., Ltd. (주식회사 목소리네트워크) · Representative: Lee Gi-ryun (이기륜)<br />
          Business registration no. 628-86-01742<br />
          Address: 경기도 광명시 디지털로 24, 102동 2301호<br />
          Contact: <a href="mailto:contact@a-codeai.com">contact@a-codeai.com</a>
        </p>
        <p class="small footer-links">
          <a href="https://jema-ai.com/privacy" target="_blank" rel="noopener noreferrer">Privacy policy (jema-ai.com)</a>
          · <a href="/legal">Legal notice</a>
          · <a href="/pilot">Pilot overview</a>
          · <a href="/benchmark">Verification policy</a>
        </p>
        <p class="small" style="margin-top:10px">
          Waitlist and enterprise apply flows may collect contact details under the linked privacy policy.
          SEND_GATE remains HOLD; no broad outbound marketing.
        </p>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p class="footer-meta">A-CODEAI · B2B token compression open bench with Fact-Lock operating discipline.</p>
      <p class="footer-meta">© 2026 주식회사 목소리네트워크. All rights reserved.</p>
    </div>
  </footer>
<script>
  (async function () {
    const lang = (document.documentElement.lang || 'en').toLowerCase();
    const isKo = lang.startsWith('ko');
    try {
      const res = await fetch('/a_codeai_public_copy_web_payload_latest.json', { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      const sections = (isKo && data.sections_ko) ? data.sections_ko : (data.sections || {});
      const hero = sections.hero || {};
      const setText = (id, v) => {
        if (!v) return;
        const el = document.getElementById(id);
        if (el) el.textContent = v;
      };
      setText('pg-hero-title', hero.title);
      setText('pg-hero-subtitle', hero.subtitle);
      setText('pg-status-line', hero.status_line);

      const lanes = (data.meta || {}).lane_metrics || {};
      if (lanes.track_a_saving_pct) {
        setText(
          'pg-trust-lane-1',
          isKo
            ? `Track A active: 토큰 절감 ${lanes.track_a_saving_pct}%, 최소 jaccard ${lanes.track_a_min_jaccard} (분리 레인)`
            : `Track A active: ${lanes.track_a_saving_pct}% token saving, min jaccard ${lanes.track_a_min_jaccard} (separate lane)`
        );
      }
      if (lanes.contributor_saving_pct) {
        setText(
          'pg-trust-lane-2',
          isKo
            ? `Contributor 레인: 절감 ${lanes.contributor_saving_pct}%, raw alignment pass ${lanes.contributor_raw_alignment_pct}% (${lanes.contributor_pass_fraction})`
            : `Contributor lane: ${lanes.contributor_saving_pct}% saving, raw alignment pass ${lanes.contributor_raw_alignment_pct}% (${lanes.contributor_pass_fraction})`
        );
      }

      const claims = sections.claims || [];
      const nonClaims = sections.non_claims || [];
      setText('pg-claim-1-text', claims[0] ? ` ${claims[0]}` : null);
      setText('pg-claim-2-text', claims[1] ? ` ${claims[1]}` : null);
      setText('pg-claim-3-text', claims[2] ? ` ${claims[2]}` : null);
      setText('pg-non-claim-1-text', nonClaims[0] ? ` ${nonClaims[0]}` : null);

      const cta = sections.cta || {};
      setText('pg-cta-label', cta.label);
      setText('pg-cta-note', cta.note);
      if (cta.apply_href) {
        const apply = document.getElementById('pg-cta-apply');
        if (apply) apply.href = cta.apply_href;
      }
    } catch (_) {
      // Keep static fallback copy.
    }
  })();
</script>
</body>
</html>
