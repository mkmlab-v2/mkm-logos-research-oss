{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/workspace"
      ]
    },
    "openchrome": {
      "command": "npx",
      "args": [
        "-y",
        "openchrome-mcp@latest",
        "serve",
        "--auto-launch"
      ]
    },
    "athena-core": {
      "command": "py",
      "args": [
        "-u",
        "C:/workspace/mcp-servers/athena_core_server.py"
      ],
      "cwd": "C:/workspace",
      "env": {
        "WORKSPACE_ROOT": "C:/workspace",
        "MKM12_LTM_DB_TYPE": "file",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "C:\\workspace;C:\\workspace\\mcp-servers"
      },
      "timeout": 60000
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "athena-manseryeok": {
      "command": "py",
      "args": [
        "C:/workspace/mcp-servers/athena_manseryeok_server.py"
      ],
      "env": {
        "MANSERYEOK_DAY_ROLLOVER_POLICY": "midnight_00"
      }
    },
    "compression-server": {
      "command": "py",
      "args": [
        "C:/workspace/mcp-servers/compression_server.py"
      ],
      "env": {
        "WORKSPACE_ROOT": "C:/workspace"
      }
    },
    "hostinger-website-manager": {
      "command": "py",
      "args": [
        "C:/workspace/mcp-servers/hostinger_website_manager_server.py"
      ],
      "env": {
        "WORKSPACE_ROOT": "C:/workspace",
        "HOSTINGER_API_TOKEN": "${env:HOSTINGER_API_TOKEN}",
        "HOSTINGER_VPS_HOST": "148.230.97.246",
        "HOSTINGER_VPS_USER": "root",
        "HOSTINGER_VPS_PASSWORD": "${env:HOSTINGER_VPS_PASSWORD}",
        "HOSTINGER_VPS_PORT": "22"
      }
    },
    "devops-mcp": {
      "command": "py",
      "args": [
        "C:/workspace/mcp-servers/devops_mcp_server.py"
      ],
      "env": {
        "WORKSPACE_ROOT": "C:/workspace",
        "SSH_KEY_PATH": "${env:SSH_KEY_PATH}"
      }
    }
  }
}
