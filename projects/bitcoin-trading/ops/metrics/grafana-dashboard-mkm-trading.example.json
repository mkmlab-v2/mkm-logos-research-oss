{
  "title": "MKM Bitcoin Trading (example)",
  "uid": "mkm-btc-trading-ex",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["mkm", "bitcoin-trading"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Daemon running",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mkm_trading_daemon_running",
          "legendFormat": "{{symbol}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Engine trading enabled",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mkm_trading_engine_trading_enabled",
          "legendFormat": "{{symbol}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "WS ticks",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mkm_trading_engine_ws_tick_count",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prometheus refresh / min",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mkm_trading_prometheus_refresh_total[5m]) * 60",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "24h fills snapshot",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mkm_trading_exchange_fills_24h",
          "legendFormat": "{{symbol}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Daemon errors",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mkm_trading_daemon_error_count",
          "legendFormat": "{{symbol}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
