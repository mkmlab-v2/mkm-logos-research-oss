# Clinician Pro email (must be on KM_CLINICIAN_PRO_EMAIL_ALLOWLIST server-side)
KM_CLINICIAN_EMAIL=you@example.com

# Optional global hotkey — show window + paste clipboard into omni textarea (default Ctrl+Shift+V)
# KM_CLINICIAN_HOTKEY=Ctrl+Shift+V

# Local hot reload (Next HMR :3010 — no VPS deploy):
#   powershell -File C:\workspace\scripts\Invoke-ClinicianPasteChartLocalHotReload_v1.ps1
#
# Optional override (default prod gold panel; use 127.0.0.1:3010 for local dev)
# KM_CLINICIAN_PASTE_CHART_URL=http://127.0.0.1:3010/clinician?panel=gold
