# jema-ai.com — Next.js app (repo folder: projects/no1kmedi; package name no1kmedi-web is legacy npm id only)

# --- Internal/admin API (hybrid: Vercel or CF front → Next API on VPS/origin) ---
# Server-side secret. Callers send the same value via:
#   Header: x-no1kmedi-admin-token: <token>
#   Or:    Authorization: Bearer <token>
# Used by admin intake routes, verification review, etc. (see src/lib/internal-api-auth.ts)
# Production: set on the Node process that serves Next; rotate by redeploy + update CI/scripts.
# Avoid exposing this token in browser-facing dashboards — use a server-only proxy route or SSH tunnel.
# Keep empty in local quick tests unless you want strict admin auth.
NO1KMEDI_ADMIN_TOKEN=

# Optional external manseryeok API for CDSS lane-A reference.
# If empty, CDSS uses fallback label and returns saju_source=fallback.
# POST JSON (preferred): { "birth_instant_utc": "ISO-with-Z-or-offset", "iana_tz": "Asia/Seoul" }
# Legacy: { "birth_datetime": "YYYY-MM-DD HH:mm" } — ambiguous for DST/global users.
# Example:
# ATHENA_MANSERYEOK_API_URL=https://api.example.com/manseryeok/reference
ATHENA_MANSERYEOK_API_URL=
# Optional auth token sent as x-api-token header to ATHENA_MANSERYEOK_API_URL
ATHENA_MANSERYEOK_API_TOKEN=

# Internal engine proxy (same deploy): POST /api/manseryeok/reference shells run_saju_global_birth_v1.py.
# Dev: ATHENA_MANSERYEOK_API_URL=http://127.0.0.1:3010/api/manseryeok/reference and MKM_WORKSPACE_ROOT=C:\workspace (or repo root).
# Optional: MANSERYEOK_REFERENCE_TOKEN — if set, route requires matching x-api-token (align ATHENA_MANSERYEOK_API_TOKEN when using self).
# MANSERYEOK_REFERENCE_TOKEN=
# MKM_WORKSPACE_ROOT=C:\workspace
# MKM_PYTHON=py — Windows launcher; Linux VPS: /usr/bin/python3
# KM_CDS_ENVELOPE_VALIDATE=1 — advanced-consult also runs Python km_physician_cds_assist_envelope builder (default: on when MKM_WORKSPACE_ROOT is set).
# KM_CDS_ENVELOPE_VALIDATE=0
# KM_PATIENT_CARE_BUNDLE_TOKEN= — if set, POST /api/cdss/patient-care-bundle-from-cds requires x-api-token
# KM_PATIENT_CARE_BUNDLE_TRUST_SAME_ORIGIN=1 — with token set, /clinician same-origin fetch may omit x-api-token
# KM_CLINICIAN_PRO_EMAIL_ALLOWLIST=admin@no1kmedi.com — ops/testing: unlock /clinician Pro gate without payapp store (comma-separated)
# MANSERYEOK_PYTHON=py

# Optional per-IP rate limit for admin verification review endpoint.
# Defaults: 20 requests per 60s
# NO1KMEDI_REVIEW_RATE_LIMIT_MAX=20
# NO1KMEDI_REVIEW_RATE_LIMIT_WINDOW_MS=60000

# Optional override for smoke scripts if target is not local default.
# NO1KMEDI_BASE_URL=http://127.0.0.1:3010

# Optional webhook endpoint for free validation leads.
# If set, /api/leads/free-validation will POST normalized lead payload and retry once on failure.
# Example:
# FREE_VALIDATION_LEAD_WEBHOOK_URL=https://hooks.example.com/no1kmedi/free-validation
FREE_VALIDATION_LEAD_WEBHOOK_URL=

# Optional webhook endpoint for patient pre-survey intake queue.
# If set, /api/intake/patient-presurvey forwards normalized triage payload.
# PATIENT_PRESURVEY_WEBHOOK_URL=https://hooks.example.com/no1kmedi/patient-presurvey

# Clinic intake v1 (QR 문진) — 요약 페이로드만 POST (민감 원문 전체 금지 정책은 코드·아티팩트와 정합).
# 비어 있으면 서버는 저장만 하고 외부 전송은 생략합니다.
# 카카오 비즈니스·알림톡은 보통 별도 중계(n8n/Make/사내 게이트웨이) URL을 받습니다. Slack 호환 분기: hooks.slack.com.
# KAKAO_CLINIC_INTAKE_WEBHOOK_URL=https://example.com/your-intake-webhook

# Payment/member store driver.
# - file: current default (memory/commercialization/*.json)
# - postgres: uses NO1KMEDI_POSTGRES_URL (or DATABASE_URL) and creates tables automatically
# NO1KMEDI_STORE_DRIVER=file
# NO1KMEDI_POSTGRES_URL=postgres://user:pass@host:5432/dbname
# NO1KMEDI_POSTGRES_POOL_MAX=10

# Paddle.js checkout (public client-side env for web integration)
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=ptlc_...
# NEXT_PUBLIC_PADDLE_PRICE_ID=pri_...
# NEXT_PUBLIC_PADDLE_ENV=sandbox   # sandbox | live
# Dashboard (same sandbox/live vendor as the token): Checkout > Checkout settings > Default payment link — required
# or Paddle.js POST .../transaction-checkout/paddlejs may return 400 (e.g. default checkout URL not set).

# Cost-first LLM router (OpenAI-compatible API; optional).
# If disabled or not configured, CDSS uses deterministic fallback template output (한의사 UI에 "템플릿 초안" 안내).
CDSS_LLM_ENABLED=false
CDSS_LLM_API_BASE_URL=
CDSS_LLM_API_KEY=
# When true and CDSS_LLM_API_* are empty: reuse OPENROUTER_API_KEY + OPENROUTER_BASE_URL (same stack as guardian chat).
CDSS_LLM_USE_OPENROUTER=false
# Primary low-cost model (e.g. gpt-4o-mini, google/gemini-2.0-flash-001 on OpenRouter). If empty, falls back to OPENROUTER_MODEL.
CDSS_LLM_PRIMARY_MODEL=
# Cheaper/backup model for primary failure
CDSS_LLM_FALLBACK_MODEL=
# Optional higher-quality model only for complex cases
CDSS_LLM_ESCALATION_MODEL=
# Request timeout in milliseconds
CDSS_LLM_TIMEOUT_MS=12000

# OpenRouter settings for patient/guardian chat routes.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-domain.example
# OPENROUTER_APP_NAME=jema-ai.com

# Optional: Ollama (or any OpenAI-compatible /v1/chat/completions) for guardian chat when OpenRouter fails or key absent.
# Same convention as workspace .env.example / payapp-api.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e2b
# Or full URL:
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# LOCAL_LLM_MODEL=gemma4:e2b
# LOCAL_LLM_TIMEOUT_MS=120000
# Optional bearer if your proxy requires it:
# LOCAL_LLM_API_KEY=

# Google credits (Gemini direct, OpenAI-compatible endpoint)
# GEMINI_API_KEY=AIza...
# Optional alias:
# GOOGLE_API_KEY=AIza...
# Optional model override (default gemini-2.5-flash)
# JEMA_AI_GEMINI_MODEL=gemini-2.5-flash
# For CDSS router (default is Gemini-first when key exists and CDSS_LLM_USE_OPENROUTER!=true)
# CDSS_LLM_USE_GEMINI=true
# CDSS_GEMINI_MODEL=gemini-2.5-flash

# Global LLM priority (jema-ai.com, api.no1kmedi.com, mkmlife study LLM when AZURE_OPENAI_* set).
# MKM_LLM_PRIORITY=azure_first
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Routing: azure_first (default when Azure configured) -> Gemini -> OpenRouter -> local.
# Supported: azure_first | azure_only | gemini_first | openrouter_first | local_first | gemini_only | openrouter_only | local_only | auto
# JEMA_AI_LLM_PRIORITY=azure_first

# Guardian public chat: overrides JEMA_AI_LLM_PRIORITY when set.
# GUARDIAN_CHAT_LLM_PRIORITY=azure_first

# YouTube automation (MKMLAB promo)
# Security: keep tokens in environment only; never commit secrets.
# YOUTUBE_ACCESS_TOKEN=
# YOUTUBE_DEFAULT_VISIBILITY=private
# YOUTUBE_CATEGORY_ID=28

# Recommended commands:
# - CI/light (no dev server smokes): npm run gate:fast  OR  RECOMMENDED_GATE_FAST=true npm run gate:recommended
#     from workspace root: node scripts/run-no1kmedi-gate-fast.mjs
#     full HTTP smokes (starts temp Next dev; slow): node scripts/run-no1kmedi-smoke-full.mjs
#     auto verify (live if reachable, else full): node scripts/run-no1kmedi-verify-auto.mjs
# - Unified verify aliases:
#     npm run verify:local   (fast)
#     npm run verify:full    (all HTTP smokes)
#     npm run verify:live    (requires live manseryeok endpoint)
#     npm run verify:auto    (live endpoint reachable면 live, 아니면 full)
#     npm run verify:postgres (NO1KMEDI_POSTGRES_URL required; forces postgres driver)
# - Standard local gate: npm run build
# - Live manseryeok required gate: npm run build:live
# - Guardian LLM priority smoke:
#     from projects/no1kmedi: npm run smoke:guardian-llm-priority
#     from workspace root: node scripts/run-no1kmedi-smoke-guardian-llm-priority.mjs  (or full path to that .mjs from any cwd)
# (With Next running) HTTP: npm run smoke:guardian-ai-chat  |  npm run smoke:guardian-ai-post  |  npm run smoke:partner-clinic-chat
# (NO1KMEDI_BASE_URL optional)

# --- Figma Layer B (DEFERRED · opt-in manual only — not a deploy gate) ---
# Production uses code-first tokens (Layer A). Set below only when a Figma *Design* file exists.
# FIGMA_TARGET_DESIGN_URL=https://www.figma.com/design/XXXXXXXX/Homepage
# FIGMA_HERO_NODE_ID=12:34
# FIGMA_HERO_FRAME_NAME=Home_Hero_Section
# Opt-in check: node scripts/resolve_no1kmedi_figma_hero_target_v1.mjs  (exit 2 = deferred skip)
