# no1kmedi-web (Next.js)

# Admin review token for /api/member/verification/review
# Keep empty in local quick tests unless you want strict admin auth.
NO1KMEDI_ADMIN_TOKEN=

# Optional external manseryeok API for CDSS lane-A reference.
# If empty, CDSS uses fallback label and returns saju_source=fallback.
# Example:
# ATHENA_MANSERYEOK_API_URL=https://api.example.com/manseryeok/reference
ATHENA_MANSERYEOK_API_URL=
# Optional auth token sent as x-api-token header to ATHENA_MANSERYEOK_API_URL
ATHENA_MANSERYEOK_API_TOKEN=

# Optional per-IP rate limit for admin verification review endpoint.
# Defaults: 20 requests per 60s
# NO1KMEDI_REVIEW_RATE_LIMIT_MAX=20
# NO1KMEDI_REVIEW_RATE_LIMIT_WINDOW_MS=60000

# Optional override for smoke scripts if target is not local default.
# NO1KMEDI_BASE_URL=http://127.0.0.1:3010

# Optional webhook endpoint for free validation leads.
# If set, /api/leads/free-validation will POST normalized lead payload and retry once on failure.
# Example:
# FREE_VALIDATION_LEAD_WEBHOOK_URL=https://hooks.example.com/no1kmedi/free-validation
FREE_VALIDATION_LEAD_WEBHOOK_URL=

# Recommended commands:
# - Standard local gate: npm run build
# - Live manseryeok required gate: npm run build:live
