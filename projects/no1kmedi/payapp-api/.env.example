# no1kmedi-payapp-api (Express on Hostinger or local)
PORT=3000

# PayApp / member admin
NO1KMEDI_ADMIN_TOKEN=

# AI routing — hybrid needs at least ONE of: N8N_WEBHOOK_URL, LOCAL_LLM_URL, OPENROUTER_API_KEY
# (Otherwise non-guard chat returns HTTP 503 ai_backend_unconfigured; adversarial guard still works.)
AI_ROUTER_MODE=hybrid
N8N_WEBHOOK_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
LOCAL_LLM_URL=

# 1 = adversarial short-circuit + emergency system hint + CoT strip (default)
AI_CHAT_GUARDS=1
