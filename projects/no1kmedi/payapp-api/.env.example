# no1kmedi-payapp-api (Express on Hostinger or local)
# Avoid :3000 if another dev server (e.g. Next.js) uses it locally
PORT=3847

# PayApp / member admin
NO1KMEDI_ADMIN_TOKEN=

# AI routing — hybrid needs at least ONE of: N8N_WEBHOOK_URL, LOCAL_LLM_URL, OPENROUTER_API_KEY
# (Otherwise non-guard chat returns HTTP 503 ai_backend_unconfigured; adversarial guard still works.)
AI_ROUTER_MODE=hybrid
# n8n webhook HTTP timeout (ms). Shorter = faster hybrid failover to local/OpenRouter.
N8N_FETCH_TIMEOUT_MS=12000
OPENROUTER_FETCH_TIMEOUT_MS=60000
N8N_WEBHOOK_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
LOCAL_LLM_URL=
# If empty, server derives URL from workspace/root .env: OLLAMA_HOST + /v1/chat/completions
# OLLAMA_HOST=http://127.0.0.1:11434
# Used by check-local-llm.mjs and OpenAI-compatible backends (Ollama/vLLM)
LOCAL_LLM_MODEL=
# If empty, falls back to OLLAMA_MODEL (e.g. gemma4:e2b)
# OLLAMA_MODEL=gemma4:e2b
LOCAL_LLM_TIMEOUT_MS=15000

# mkmlife.com only (POST body site_profile=mkmlife): optional router + default models
# MKMLIFE_AI_ROUTER_MODE=openrouter
# MKMLIFE_OPENROUTER_MODEL=openai/gpt-4o-mini
# MKMLIFE_LOCAL_LLM_MODEL=gemma4:e2b

# Self-hosted LLM path (recommended on VPS):
#   AI_ROUTER_MODE=local
#   LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# Then: bash deploy-vps-local-llm.sh

# 1 = adversarial short-circuit + emergency system hint + CoT strip (default)
AI_CHAT_GUARDS=1

# Clients (mkmlife.com, no1kmedi.com) should send on POST /api/ai/chat:
#   site_profile=mkmlife|no1kmedi  (alias: profile)
# JSON mode: json_schema=hanui_clinical_v1 | mkmlife_consumer_v1 (defaults by site_profile)
