{
  "name": "no1kmedi-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild:auto": "npm run check:marketing-copy && npm run check:trackc-claims && npm run gate:recommended",
    "prebuild": "npm run check:marketing-copy && npm run check:trackc-claims && npm run smoke:commercialization-gate",
    "prebuild:live": "npm run check:marketing-copy && npm run check:trackc-claims && npm run check:manseryeok-live-env && npm run smoke:commercialization-gate:live",
    "dev": "next dev -p 3010",
    "build": "next build",
    "build:auto": "next build",
    "build:live": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "smoke:advanced-consult": "node ./scripts/smoke-advanced-consult.mjs",
    "smoke:advanced-consult:live": "node ./scripts/smoke-advanced-consult.mjs --require-live",
    "smoke:member-access-flow": "node ./scripts/smoke-member-access-flow.mjs",
    "smoke:commercialization-gate": "node ./scripts/smoke-commercialization-gate.mjs",
    "smoke:commercialization-gate:live": "node ./scripts/smoke-commercialization-gate.mjs --require-live",
    "check:manseryeok-live-env": "node ./scripts/check-manseryeok-live-env.mjs",
    "check:marketing-copy": "node ./scripts/check-marketing-copy-compliance.mjs",
    "build:trackc-evidence": "py ../../scripts/build_track_c_evidence_pack_v1.py",
    "check:trackc-copy-guard": "py ../../scripts/check_track_c_copy_guard_v1.py ../../docs/final/TRACK_C_IP_BUSINESS_PLAN_2026-04-17.md",
    "check:trackc-claims": "npm run build:trackc-evidence && npm run check:trackc-copy-guard && py ../../scripts/validate_track_c_landing_claims_v1.py --landing-copy docs/final/TRACK_C_IP_BUSINESS_PLAN_2026-04-17.md --evidence-pack docs/final/artifacts/track_c_evidence_pack_latest.json",
    "bench:cdss": "node ./scripts/run-cdss-benchmark.mjs && node ./scripts/summarize-cdss-benchmark.mjs",
    "gate:recommended": "node ./scripts/run-recommended-gate.mjs",
    "manseryeok:local-api": "node ./scripts/start-manseryeok-local-api.mjs"
  },
  "dependencies": {
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.18",
    "typescript": "^5.6.3"
  }
}
