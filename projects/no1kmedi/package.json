{
  "name": "no1kmedi-web",
  "description": "jema-ai.com — public brand; workspace folder projects/no1kmedi is repo path only (npm name legacy).",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:constitution-survey-schema": "node -e \"console.log('skip: sync-constitution-survey-schema (script missing in current repo)')\"",
    "sync:marketing-copy": "node ./scripts/sync-marketing-site-copy.mjs",
    "prebuild:auto": "npm run sync:constitution-survey-schema && npm run sync:marketing-copy && npm run check:marketing-copy && npm run check:trackc-claims",
    "prebuild": "npm run sync:constitution-survey-schema && npm run sync:marketing-copy && npm run check:marketing-copy && npm run check:trackc-claims",
    "prebuild:live": "npm run sync:constitution-survey-schema && npm run sync:marketing-copy && npm run check:marketing-copy && npm run check:trackc-claims && npm run check:manseryeok-live-env",
    "dev": "next dev -p 3010",
    "build": "next build",
    "build:auto": "next build",
    "build:live": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "smoke:advanced-consult": "node ./scripts/smoke-advanced-consult.mjs",
    "smoke:km-cds-envelope-adapter": "npx --yes tsx ./scripts/smoke-km-cds-envelope-adapter-v1.ts",
    "smoke:patient-care-bundle-from-cds": "npx --yes tsx ./scripts/smoke-patient-care-bundle-from-cds-v1.ts",
    "smoke:clinician-cds-bundle-http": "node ./scripts/smoke-clinician-cds-bundle-http.mjs",
    "smoke:clinician-cds-bundle-http:strict": "node ./scripts/smoke-clinician-cds-bundle-http.mjs --require-validate",
    "verify:clinician-cds-bundle": "pwsh -NoProfile -File ./scripts/run-clinician-cds-bundle-smoke.ps1",
    "verify:clinician-cds-bundle:offline": "pwsh -NoProfile -File ./scripts/run-clinician-cds-bundle-smoke.ps1 -SkipHttp",
    "smoke:advanced-consult:literature": "node ./scripts/smoke-advanced-consult.mjs --require-literature",
    "smoke:advanced-consult:live": "node ./scripts/smoke-advanced-consult.mjs --require-live",
    "preflight:advanced-consult:literature": "npm run build:literature:memory && npm run smoke:advanced-consult:literature",
    "verify:advanced-consult:literature:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-advanced-consult-literature-smoke.ps1",
    "verify:advanced-consult:literature:auto:fixed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-advanced-consult-literature-smoke.ps1 -NoAutoPort",
    "smoke:member-access-flow": "node ./scripts/smoke-member-access-flow.mjs",
    "report:km-cds-ui-events": "node ./scripts/summarize-km-cds-ui-events.mjs",
    "collect:literature:epmc": "node ./scripts/collect-literature-epmc.mjs",
    "build:literature:memory": "node ./scripts/build-literature-memory-snapshot.mjs",
    "smoke:o2o:live": "node ./scripts/smoke-o2o-live.mjs",
    "smoke:guardian-llm-priority": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/smoke-guardian-llm-priority.mts",
    "smoke:partner-clinic-chat": "node ./scripts/smoke-partner-clinic-chat.mjs",
    "smoke:guardian-ai-chat": "node ./scripts/smoke-guardian-ai-chat.mjs",
    "smoke:guardian-ai-post": "node ./scripts/smoke-guardian-ai-post.mjs",
    "smoke:clinic-intake-v1": "node ./scripts/smoke-clinic-intake-v1.mjs",
    "smoke:gemini-route": "node ./scripts/smoke-gemini-route.mjs",
    "smoke:commercialization-gate": "node ./scripts/smoke-commercialization-gate.mjs",
    "smoke:commercialization-gate:live": "node ./scripts/smoke-commercialization-gate.mjs --require-live",
    "youtube:copy": "node ./scripts/generate-youtube-marketing-copy.mjs",
    "youtube:token:init": "python -u ./scripts/obtain-youtube-refresh-token.py",
    "youtube:token:refresh": "node ./scripts/refresh-youtube-access-token.mjs",
    "youtube:upload": "node ./scripts/upload-youtube-video-secure.mjs",
    "youtube:two-stage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-youtube-two-stage.ps1",
    "youtube:task:register": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/register-youtube-auto-task.ps1",
    "youtube:auto": "node ./scripts/run-youtube-automation.mjs",
    "check:manseryeok-live-env": "node ./scripts/check-manseryeok-live-env.mjs",
    "smoke:manseryeok-reference": "node ./scripts/smoke-manseryeok-reference.mjs",
    "check:design-tokens": "node ./scripts/check-design-tokens-smoke.mjs",
    "check:staging-preflight": "node ./scripts/check-no1kmedi-staging-preflight_v1.mjs",
    "check:staging-vps-pm2": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/Invoke-No1kmediVpsPm2Preflight_v1.ps1",
    "check:infra-closure": "node ./scripts/check-no1kmedi-infra-closure_v1.mjs",
    "check:subroutes-smoke": "node ./scripts/check-no1kmedi-subroutes-smoke_v1.mjs",
    "check:parallel-push": "node ./scripts/check-no1kmedi-parallel-push_v1.mjs",
    "check:deploy-readiness": "node ./scripts/check-no1kmedi-deploy-readiness_v1.mjs",
    "check:clinician-pilot-commercial": "node ./scripts/check-clinician-pilot-commercial-smoke_v1.mjs",
    "check:portal-local-smoke": "node ./scripts/check-no1kmedi-portal-local-smoke_v1.mjs",
    "check:public-copy-schema": "node ./scripts/check-public-copy-schema.mjs",
    "check:marketing-copy": "npm run check:public-copy-schema && node ./scripts/check-marketing-copy-compliance.mjs",
    "bench:cdss:generate100": "node ./scripts/generate-cdss-benchmark-100.mjs",
    "build:trackc-evidence": "node ./scripts/run-python-portable.mjs ../../scripts/build_track_c_evidence_pack_v1.py",
    "check:trackc-copy-guard": "node ./scripts/run-python-portable.mjs ../../scripts/check_track_c_copy_guard_v1.py ../../docs/final/TRACK_C_IP_BUSINESS_PLAN_2026-04-17.md",
    "check:trackc-claims": "node ./scripts/run-trackc-claims.mjs",
    "bench:cdss": "node ./scripts/run-cdss-benchmark.mjs && node ./scripts/summarize-cdss-benchmark.mjs",
    "bench:cdss:100": "npm run bench:cdss:generate100 && node ./scripts/run-cdss-benchmark.mjs --dataset ./benchmarks/cdss-eval-cases.100.json --output ./memory/benchmarks/cdss-benchmark-result.100.json && node ./scripts/summarize-cdss-benchmark.mjs --input ./memory/benchmarks/cdss-benchmark-result.100.json --report ./memory/benchmarks/cdss-benchmark-report.100.md",
    "gate:recommended": "node ./scripts/run-recommended-gate.mjs",
    "gate:fast": "npm run smoke:guardian-llm-priority && npx next build",
    "verify:local": "npm run gate:fast",
    "verify:full": "npm run smoke:commercialization-gate",
    "verify:live": "npm run check:manseryeok-live-env && npm run smoke:commercialization-gate:live",
    "verify:auto": "node ./scripts/run-verify-auto.mjs",
    "verify:postgres": "node ./scripts/run-verify-postgres.mjs",
    "ops:llm:sync-gemini-key": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:/workspace/scripts/Sync-UnifiedGeminiKey.ps1\"",
    "manseryeok:local-api": "node ./scripts/start-manseryeok-local-api.mjs"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.2.7",
    "next": "^14.2.18",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.18",
    "typescript": "^5.6.3"
  }
}
